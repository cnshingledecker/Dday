@article{charnley_molecular_1992,
	title = {On the molecular complexity of the hot cores in {Orion} {A} - {Grain} surface chemistry as '{The} last refuge of the scoundrel'},
	volume = {399},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1992ApJ...399L..71C},
	doi = {10.1086/186609},
	abstract = {We have modeled the gas phase chemistry of warm molecular material 
