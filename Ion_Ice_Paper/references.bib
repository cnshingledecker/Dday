@article{chen_formation_2015,
	title = {Formation of {S}-bearing {Species} by {VUV}/{EUV} {Irradiation} of {H2S}-containing {Ice} {Mixtures}: {Photon} {Energy} and {Carbon} {Source} {Effects}},
	volume = {798},
	issn = {0004-637X},
	shorttitle = {Formation of {S}-bearing {Species} by {VUV}/{EUV} {Irradiation} of {H2S}-containing {Ice} {Mixtures}},
	url = {http://adsabs.harvard.edu/abs/2015ApJ...798...80C},
	doi = {10.1088/0004-637X/798/2/80},
	abstract = {Carbonyl sulfide (OCS) is a key molecule in astrobiology that acts as a 
catalyst in peptide synthesis by coupling amino acids. Experimental
studies suggest that hydrogen sulfide (H2S), a precursor of
OCS, could be present in astrophysical environments. In the present
study, we used a microwave-discharge hydrogen-flow lamp, simulating the
interstellar UV field, and a monochromatic synchrotron light beam to
irradiate CO:H2S and CO2:H2S ice
mixtures at 14 K with vacuum ultraviolet (VUV) or extreme ultraviolet
(EUV) photons in order to study the effect of the photon energy and
carbon source on the formation mechanisms and production yields of
S-containing products (CS2, OCS, SO2, etc.).
Results show that (1) the photo-induced OCS production efficiency in
CO:H2S ice mixtures is higher than that of
CO2:H2S ice mixtures; (2) a lower concentration of
H2S enhances the production efficiency of OCS in both ice
mixtures; and (3) the formation pathways of CS2 differ
significantly upon VUV and EUV irradiations. Furthermore, CS2
was produced only after VUV photoprocessing of CO:H2S ices,
while the VUV-induced production of SO2 occurred only in
CO2:H2S ice mixtures. More generally, the
production yields of OCS, H2S2, and CS2
were studied as a function of the irradiation photon energy. Heavy
S-bearing compounds were also observed using mass spectrometry during
the warm-up of VUV/EUV-irradiated CO:H2S ice mixtures. The
presence of S-polymers in dust grains may account for the missing sulfur
in dense clouds and circumstellar environments.},
	urldate = {2018-09-25},
	journal = {The Astrophysical Journal},
	author = {Chen, Y.-J. and Juang, K.-J. and Nuevo, M. and Jiménez-Escobar, A. and Muñoz Caro, G. M. and Qiu, J.-M. and Chu, C.-C. and Yih, T.-S. and Wu, C.-Y. R. and Fung, H.-S. and Ip, W.-H.},
	month = jan,
	year = {2015},
	keywords = {astrochemistry, methods: laboratory: molecular, molecular processes, ultraviolet: ISM},
	pages = {80},
}

@article{martin-domenech_sulfur_2016,
	title = {The sulfur depletion problem: upper limits on the {H2S2}, {HS}·2, and {S2} gas-phase abundances toward the low-mass warm core {IRAS} 16293-2422},
	volume = {585},
	copyright = {© ESO, 2016},
	issn = {0004-6361, 1432-0746},
	shorttitle = {The sulfur depletion problem},
	url = {https://www.aanda.org/articles/aa/abs/2016/01/aa26271-15/aa26271-15.html},
	doi = {10.1051/0004-6361/201526271},
	abstract = {{\textless}i{\textgreater}Context. {\textless}i/{\textgreater}A fraction of the missing sulfur in dense clouds and circumstellar regions could be in the form of three species not yet detected in the interstellar medium: H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, HS{\textless}sup{\textgreater}.{\textless}sup/{\textgreater}{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, and S{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} according to experimental simulations performed under astrophysically relevant conditions. These S-S bonded molecules can be formed by the energetic processing of H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S-bearing ice mantles on dust grains, and subsequently desorb to the gas phase.{\textless}i{\textgreater}Aims. {\textless}i/{\textgreater}The detection of these species could partially solve the sulfur depletion problem, and would help to improve our knowledge of the poorly known chemistry of sulfur in the interstellar medium. To this purpose we calculated the frequencies and expected intensities of the rotational transitions not previously reported, and performed dedicated ground-based observations toward the low-mass warm core IRAS 16293-2422, a region with one of the highest measured gas-phase H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S abundances.{\textless}i{\textgreater}Methods. {\textless}i/{\textgreater}Observations in the submillimeter regime were obtained with the APEX 12 m telescope during 15 h of observation. A total of {\textasciitilde}16 GHz were covered in a range of about 100 GHz, targeting a wide selection of the predicted rotational transitions of the three molecules.{\textless}i{\textgreater}Results. {\textless}i/{\textgreater}The 1{\textless}i{\textgreater}σ{\textless}i/{\textgreater} noise rms values were extracted in the spectral regions where the targeted species should have been detected. These values were a factor of 2−7 lower than those reached by previous observations toward the same source, and allowed us to estimate a 1{\textless}i{\textgreater}σ{\textless}i/{\textgreater} upper limit to their molecular abundances of ≤8.1 × 10{\textless}sup{\textgreater}-9{\textless}sup/{\textgreater}, ≤ 1.1 × 10{\textless}sup{\textgreater}-8{\textless}sup/{\textgreater}, and ≤ 2.9 × 10{\textless}sup{\textgreater}-7{\textless}sup/{\textgreater} relative to H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, for H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S {\textless}sub{\textgreater}2{\textless}sub/{\textgreater} , HS{\textless}sup{\textgreater}.{\textless}sup/{\textgreater}{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, and S{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, respectively.{\textless}i{\textgreater}Conclusions. {\textless}i/{\textgreater}The upper limit abundances of the three molecules containing the S{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} unit are up to two orders of magnitude lower than the H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S abundance in the source, and one order of magnitude lower than the expected abundances from the experimental simulations using ice analogs. Subsequent gas-phase chemistry after desorption could lower the abundances of the three species to undetectable levels in our observations.},
	language = {en},
	urldate = {2018-09-25},
	journal = {Astronomy \& Astrophysics},
	author = {Martín-Doménech, R. and Jiménez-Serra, I. and Caro, G. M. Muñoz and Müller, H. S. P. and Occhiogrosso, A. and Testi, L. and Woods, P. M. and Viti, S.},
	month = jan,
	year = {2016},
	pages = {A112},
}

@article{fuente_first_2017,
	title = {First {Detection} of {Interstellar} {S} 2 {H}},
	volume = {851},
	issn = {2041-8205},
	url = {http://stacks.iop.org/2041-8205/851/i=2/a=L49},
	doi = {10.3847/2041-8213/aaa01b},
	abstract = {We present the first detection of gas-phase S 2 H in the Horsehead, a moderately UV-irradiated nebula. This confirms the presence of doubly sulfuretted species in the interstellar medium and opens a new challenge for sulfur chemistry. The observed S 2 H abundance is ∼5 × 10 −11 , only a factor of 4–6 lower than that of the widespread H 2 S molecule. H 2 S and S 2 H are efficiently formed on the UV-irradiated icy grain mantles. We performed ice irradiation experiments to determine the H 2 S and S 2 H photodesorption yields. The obtained values are ∼1.2 × 10 −3 and {\textless}1 × 10 −5 molecules per incident photon for H 2 S and S 2 H, respectively. Our upper limit to the S 2 H photodesorption yield suggests that photodesorption is not a competitive mechanism to release the S 2 H molecules to the gas phase. Other desorption mechanisms such as chemical desorption, cosmic-ray desorption, and grain shattering can increase the gaseous S 2 H abundance to some extent. Alternatively, S 2 H can be formed via gas-phase reactions involving gaseous H 2 S and the abundant ions S + and SH + . The detection of S 2 H in this nebula therefore could be the result of the coexistence of an active grain-surface chemistry and gaseous photochemistry.},
	language = {en},
	number = {2},
	urldate = {2018-09-25},
	journal = {The Astrophysical Journal Letters},
	author = {Fuente, Asunción and Goicoechea, Javier R. and Pety, Jérôme and Gal, Romane Le and Martín-Doménech, Rafael and {Pierre Gratier} and Guzmán, Viviana and Roueff, Evelyne and Loison, Jean Christophe and Caro, Guillermo M. Muñoz and {Valentine Wakelam} and Gerin, Maryvonne and Riviere-Marichalar, Pablo and Vidal, Thomas},
	year = {2017},
	pages = {L49},
}

