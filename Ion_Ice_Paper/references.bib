@article{carlsson_definition_1979,
	title = {Definition of {Energy} {Imparted}: {A} {New} {Formulation} {Adapted} to {Exact} {Solutions} of the {Absorbed} {Dose} {Equation} under {Nonequilibrium} {Conditions}},
	volume = {77},
	copyright = {Copyright © 1979 Radiation Research Society},
	issn = {00337587},
	url = {http://www.jstor.org/stable/3575133},
	doi = {10.2307/3575133},
	abstract = {The volume- and time-dependent stochastic quantity the energy imparted, ε, defined by the International Commission on Radiation Units and Measurements, can be represented alternatively as the sum of volume- and time-independent contributions Δε from individual basic processes. In an interaction by an ionizing particle, Δε equals that part of the radiation energy which is converted into energy forms other than the kinetic energy of ionizing particles and rest-mass energy of nuclei and elementary particles. In a spontaneous process such as a nuclear decay, Δε is equal to that part of the released rest-mass energy which is not converted into the kinetic energy of ionizing particles. The nonstochastic quantity the absorbed dose, D, is the mean energy imparted per unit mass of a medium. It is a volume-independent quantity and the values of Δε for individual processes are the quantities of real significance in calculations of the absorbed dose in situations where radiation equilibrium has not been established, e.g., in small Bragg-Gray cavities. More information about the values of Δε for individual processes and the spectral distributions of ionizing particles is needed for the accurate treatment of cavity and interface dosimetry theories.},
	number = {2},
	journal = {Radiation Research},
	author = {Carlsson, Gudrun Alm},
	month = feb,
	year = {1979},
	pages = {209--220},
}

