	journal = {The Astrophysical Journal},
	author = {Brown, R. D. and Godfrey, P. D. and Cragg, D. M. and Rice, E. H. N. and Irvine, W. M. and Friberg, P. and Suzuki, H. and Ohishi, M. and Kaifu, N. and Morimoto, M.},
