@article{rodriguez-fernandez_non-equilibrium_2000,
	title = {Non-equilibrium {H}\_2 ortho-to-para ratio in two molecular clouds of the {Galactic} {Center}},
	volume = {356},
	issn = {0004-6361},
	url = {https://ui.adsabs.harvard.edu/abs/2000A&A...356..695R/abstract},
	abstract = {We present ISO observations of the S(0), S(1), S(2), and S(3) rotational lines of molecular hydrogen from two molecular clouds near the Galactic Center (GC). We have also measured continuum dust emission at infrared wavelengths with ISO and the rotational radio lines J=1-0 of {\textless}SUP{\textgreater}13{\textless}/SUP{\textgreater}CO and C{\textless}SUP{\textgreater}18{\textless}/SUP{\textgreater}O and J=2-1 of C{\textless}SUP{\textgreater}18{\textless}/SUP{\textgreater}O with the IRAM-30m telescope. Using the dust continuum spectra and the CO lines we derive a total visual extinction of s{\textasciicircum}\{-1\}im 15-20 magnitudes toward these GC clouds. After correcting the H\_2 data for extinction, the gas temperatures are s{\textasciicircum}\{-1\}im 250 K and the column densities of warm gas are s{\textasciicircum}\{-1\}im 2x 10{\textless}SUP{\textgreater}21{\textless}/SUP{\textgreater} cm{\textless}SUP{\textgreater}-2{\textless}/SUP{\textgreater}. This is the first direct measure of the H\_2 column densities of the warm component; with this, we estimate an NH\_3 abundance in the warm gas of s{\textasciicircum}\{-1\}im 2 10{\textless}SUP{\textgreater}-7{\textless}/SUP{\textgreater}. The column density of warm gas is, at least, a factor of 100 larger than the corresponding column densities derived from the warm dust. The observed ortho-to-para ratio (OTPR) is s{\textasciicircum}\{-1\}im 1, clearly below the local thermodynamical equilibrium (LTE) OTPR for gas at 250 K of s{\textasciicircum}\{-1\}im 3. Low velocity shocks (s{\textasciicircum}\{-1\}im 10 km s{\textless}SUP{\textgreater}-1{\textless}/SUP{\textgreater}) are the most likely explanation for the column densities of warm gas and dust and the non-LTE H\_2 OTPR. ISO is an ESA project with instruments funded by ESA Member States (especially the PI countries: France, Germany, the Netherlands and the United Kingdom) and with the participation of ISAS and NASA.},
	language = {en},
	urldate = {2020-01-14},
	journal = {A\&A},
	author = {Rodríguez-Fernández, N. J. and Martín-Pintado, J. and de Vicente, P. and Fuente, A. and Hüttemeister, S. and Wilson, T. L. and Kunze, D.},
	month = apr,
	year = {2000},
	pages = {695--704},
}

