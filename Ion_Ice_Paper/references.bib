@article{krieger_survey_2017,
	title = {The {Survey} of {Water} and {Ammonia} in the {Galactic} {Center} ({SWAG}): {Molecular} {Cloud} {Evolution} in the {Central} {Molecular} {Zone}},
	volume = {850},
	issn = {0004-637X},
	shorttitle = {The {Survey} of {Water} and {Ammonia} in the {Galactic} {Center} ({SWAG})},
	url = {https://doi.org/10.3847%2F1538-4357%2Faa951c},
	doi = {10.3847/1538-4357/aa951c},
	abstract = {The Survey of Water and Ammonia in the Galactic Center (SWAG) covers the Central Molecular Zone (CMZ) of the Milky Way at frequencies between 21.2 and 25.4 GHz obtained at the Australia Telescope Compact Array at ∼0.9 pc spatial and ∼2.0 km s−1 spectral resolution. In this paper, we present data on the inner ∼250 pc (1.°4) between Sgr C and Sgr B2. We focus on the hyperfine structure of the metastable ammonia inversion lines (J, K) = (1, 1)–(6, 6) to derive column density, kinematics, opacity, and kinetic gas temperature. In the CMZ molecular clouds, we find typical line widths of 8–16 km s−1 and extended regions of optically thick (τ {\textgreater} 1) emission. Two components in kinetic temperature are detected at 25–50 K and 60–100 K, both being significantly hotter than the dust temperatures throughout the CMZ. We discuss the physical state of the CMZ gas as traced by ammonia in the context of the orbital model by Kruijssen et al. that interprets the observed distribution as a stream of molecular clouds following an open eccentric orbit. This allows us to statistically investigate the time dependencies of gas temperature, column density, and line width. We find heating rates between ∼50 and ∼100 K Myr−1 along the stream orbit. No strong signs of time dependence are found for column density or line width. These quantities are likely dominated by cloud-to-cloud variations. Our results qualitatively match the predictions of the current model of tidal triggering of cloud collapse, orbital kinematics, and the observation of an evolutionary sequence of increasing star formation activity with orbital phase.},
	language = {en},
	number = {1},
	urldate = {2020-01-14},
	journal = {The Astrophysical Journal},
	author = {Krieger, Nico and Ott, Jürgen and Beuther, Henrik and Walter, Fabian and Kruijssen, J. M. Diederik and Meier, David S. and Mills, Elisabeth A. C. and Contreras, Yanett and Edwards, Phil and Ginsburg, Adam and Henkel, Christian and Henshaw, Jonathan and Jackson, James and Kauffmann, Jens and Longmore, Steven and Martín, Sergio and Morris, Mark R. and Pillai, Thushara and Rickert, Matthew and Rosolowsky, Erik and Shinnaga, Hiroko and Walsh, Andrew and Yusef-Zadeh, Farhad and Zhang, Qizhou},
	month = nov,
	year = {2017},
	pages = {77},
}

@article{ginsburg_dense_2016,
	title = {Dense gas in the {Galactic} central molecular zone is warm and heated by turbulence},
	volume = {586},
	copyright = {© ESO, 2016},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2016/02/aa26100-15/aa26100-15.html},
	doi = {10.1051/0004-6361/201526100},
	abstract = {{\textless}i{\textgreater}Context. {\textless}i/{\textgreater}The Galactic center is the closest region where we can study star formation under extreme physical conditions like those in high-redshift galaxies.{\textless}i{\textgreater}Aims. {\textless}i/{\textgreater}We measure the temperature of the dense gas in the central molecular zone (CMZ) and examine what drives it.{\textless}i{\textgreater}Methods. {\textless}i/{\textgreater}We mapped the inner 300 pc of the CMZ in the temperature-sensitive {\textless}i{\textgreater}J{\textless}i/{\textgreater} = 3–2 para-formaldehyde (p - H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}CO) transitions. We used the 3{\textless}sub{\textgreater}2,1{\textless}sub/{\textgreater}−2{\textless}sub{\textgreater}2,0{\textless}sub/{\textgreater}/ 3{\textless}sub{\textgreater}0,3{\textless}sub/{\textgreater}−2{\textless}sub{\textgreater}0,2{\textless}sub/{\textgreater} line ratio to determine the gas temperature in {\textless}i{\textgreater}n{\textless}i/{\textgreater} {\textasciitilde} 10{\textless}sup{\textgreater}4{\textless}sup/{\textgreater}−10{\textless}sup{\textgreater}5{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}-3{\textless}sup/{\textgreater} gas. We have produced temperature maps and cubes with 30′′ and 1 km s{\textless}sup{\textgreater}-1{\textless}sup/{\textgreater} resolution and published all data in FITS form.{\textless}i{\textgreater}Results. {\textless}i/{\textgreater}Dense gas temperatures in the Galactic center range from {\textasciitilde}60 K to {\textgreater}100 K in selected regions. The highest gas temperatures {\textless}i{\textgreater}T{\textless}i/{\textgreater}{\textless}sub{\textgreater}G{\textless}sub/{\textgreater}{\textgreater} 100 K are observed around the Sgr B2 cores, in the extended Sgr B2 cloud, the 20 km s{\textless}sup{\textgreater}-1{\textless}sup/{\textgreater} and 50 km s{\textless}sup{\textgreater}-1{\textless}sup/{\textgreater} clouds, and in “The Brick” (G0.253+0.016). We infer an upper limit on the cosmic ray ionization rate {\textless}i{\textgreater}ζ{\textless}i/{\textgreater}{\textless}sub{\textgreater}CR{\textless}sub/{\textgreater}{\textless} 10{\textless}sup{\textgreater}-14{\textless}sup/{\textgreater}s{\textless}sup{\textgreater}-1{\textless}sup/{\textgreater}.{\textless}i{\textgreater}Conclusions. {\textless}i/{\textgreater}The dense molecular gas temperature of the region around our Galactic center is similar to values found in the central regions of other galaxies, in particular starburst systems. The gas temperature is uniformly higher than the dust temperature, confirming that dust is a coolant in the dense gas. Turbulent heating can readily explain the observed temperatures given the observed line widths. Cosmic rays cannot explain the observed variation in gas temperatures, so CMZ dense gas temperatures are not dominated by cosmic ray heating. The gas temperatures previously observed to be high in the inner {\textasciitilde}75 pc are confirmed to be high in the entire CMZ.},
	language = {en},
	urldate = {2020-01-14},
	journal = {Astronomy \& Astrophysics},
	author = {Ginsburg, Adam and Henkel, Christian and Ao, Yiping and Riquelme, Denise and Kauffmann, Jens and Pillai, Thushara and Mills, Elisabeth A. C. and Requena-Torres, Miguel A. and Immer, Katharina and Testi, Leonardo and Ott, Juergen and Bally, John and Battersby, Cara and Darling, Jeremy and Aalto, Susanne and Stanke, Thomas and Kendrew, Sarah and Kruijssen, J. M. Diederik and Longmore, Steven and Dale, James and Guesten, Rolf and Menten, Karl M.},
	month = feb,
	year = {2016},
	pages = {A50},
}

@article{rodriguez-fernandez_warm_2001,
	title = {Warm {H} in the {Galactic} center region},
	volume = {365},
	copyright = {© ESO, 2001},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2001/02/aa10191/aa10191.html},
	doi = {10.1051/0004-6361:20000020},
	abstract = {We present ISO observations of several pure-rotational lines (from S(0) to S(5)) towards a sample of 16 molecular clouds distributed along the central {\textless}i{\textgreater}∼{\textless}i/{\textgreater}500 pc of the Galaxy. We also present and and observations of these sources made with the IRAM-30 m telescope. With the CO data we derive densities of 10{\textless}sup{\textgreater}3.5-4.0{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}-3{\textless}sup/{\textgreater} and column densities of a few 10{\textless}sup{\textgreater}22{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}-2{\textless}sup/{\textgreater}. We have corrected the data for {\textless}i{\textgreater}∼{\textless}i/{\textgreater}30 magnitudes of visual extinction using a self-consistent method. In every source, we find that the emission exhibits a large temperature gradient. The S(0) and S(1) lines trace temperatures ({\textless}i{\textgreater}T{\textless}i/{\textgreater}) of {\textless}i{\textgreater}∼{\textless}i/{\textgreater}150 K while the S(4) and S(5) lines indicate temperatures of {\textless}i{\textgreater}∼{\textless}i/{\textgreater}600 K. The warm column density is typically {\textless}i{\textgreater}∼{\textless}i/{\textgreater}1-2 10{\textless}sup{\textgreater}22{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}-2{\textless}sup/{\textgreater}, and is predominantly gas with K. This is the first direct estimate of the total column density of the warm molecular gas in the Galactic center region. These warm column densities represent a fraction of {\textless}i{\textgreater}∼{\textless}i/{\textgreater}30\% of the gas traced by the CO isotopes emission. The cooling by in the warm component is comparable to that by CO. Comparing our and CO data with available ammonia (NH{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}) observations from literature one obtains relatively high NH{\textless}sub{\textgreater}3{\textless}sub/{\textgreater} abundances of a few 10{\textless}sup{\textgreater}-7{\textless}sup/{\textgreater} in both the warm and the cold gas. A single shock or Photo-Dissociation Region (PDR) cannot explain all the observed lines. Alternatives for the heating mechanisms are discussed.},
	language = {en},
	number = {2},
	urldate = {2020-01-14},
	journal = {Astronomy \& Astrophysics},
	author = {Rodríguez-Fernández, N. J. and Martín-Pintado, J. and Fuente, A. and Vicente, P. de and Wilson, T. L. and Hüttemeister, S.},
	month = jan,
	year = {2001},
	pages = {174--185},
}

@article{noauthor_kinetic_1993,
	title = {Kinetic temperatures in {Galactic} {Center} molecular clouds.},
	volume = {280},
	issn = {0004-6361},
	url = {https://ui.adsabs.harvard.edu/abs/1993A%26A...280..255H/abstract},
	abstract = {Measurements of six metastable (J = K) inversion transitions of ammonia for 36 clouds in the galactic center region are presented. Most of the clouds are not related to Sgr A or Sgr B2. In order to minimize the effect of weather, either the (J,K) = (1,1), (2,2) and (4,4) or the (4,4) and (5,5) inversion lines of para-NH3 were measured simultaneously. A common calibration was obtained by forcing the integrated intensities of the (4,4) inversion line spectra from different periods to agree. The (3,3) and (6,6) lines of orthor-NH3 were also measured simultaneously. A determination of the rotational temperatures, T{\textless}SUB{\textgreater}rot{\textless}/SUB{\textgreater}, obtained from these lines shows that there must be at least two kinetic temperature regimes in these clouds. In a few cases, small maps of the clouds were made; two of these show that the distribution of the (1,1) and (2,2) inversion lines are similar, but differ markedly from that of the (4,4) inversion line. An analysis of the data shows that the warmer temperature is approximately 200 K, the cooler is approximately 25 K. The warmer gas contains about approximately 25\% of the total column density of NH3. The heating processes which give rise to the high kinetic temperatures in these clouds are not certain: These may include and enhanced flux of low energy cosmic rays, cloud-cloud collisions, or ion-slip (ambipolar diffusion).},
	language = {en},
	urldate = {2020-01-14},
	journal = {Astronomy and Astrophysics},
	month = dec,
	year = {1993},
	pages = {255},
}

