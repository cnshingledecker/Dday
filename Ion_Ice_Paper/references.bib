	month = may,
	year = {1981},
	keywords = {Cyano Compounds, Interstellar Chemistry, Interstellar Matter, Line Spectra, Microwave Spectra, Molecular Spectra, Positive Ions, Radial Velocity, Sulfur Compounds},
	pages = {L41--L45},
}

