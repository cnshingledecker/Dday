@article{robinson_temporal_1990,
	title = {The temporal development of collision cascades in the binary-collision approximation},
	volume = {48},
	issn = {0168-583X},
	url = {http://www.sciencedirect.com/science/article/pii/0168583X9090150S},
	doi = {http://dx.doi.org/10.1016/0168-583X(90)90150-S},
	abstract = {A modified binary-collision approximation was used to study the temporal development of cascades in Cu and Au, initiated by primary atoms of kinetic energy \&lt; −10 keV. Cascades with time-ordered collisions show fewer “distant” Frenkel pairs than those with velocity-ordered collisions. In the former, the slower projectiles tend to move in less-damaged crystal than in the latter. The effect is larger in Au than in Cu and increases with primary energy. To investigate nonlinearities, stopped cascade atoms were allowed to be redisplaced by later encounters. There were many more redisplacements in time-ordered cascades than in velocity-ordered ones. Because of the additional stopping by redisplacement events, such cascades had fewer defects. This effect also was larger in Au than in Cu and larger at high energies although the redisplacement events involved only low-energy particles.},
	number = {1–4},
	journal = {Nuclear Instruments and Methods in Physics Research Section B: Beam Interactions with Materials and Atoms},
	author = {Robinson, Mark T.},
	year = {1990},
	pages = {408 -- 413},
}

@article{robinson_computer_1992,
	title = {Computer simulation studies of high-energy collision cascades},
	volume = {67},
	issn = {0168-583X},
	url = {http://www.sciencedirect.com/science/article/pii/0168583X9295839J},
	doi = {http://dx.doi.org/10.1016/0168-583X(92)95839-J},
	abstract = {A modified binary-collision-approximation algorithm allowing the proper order of the collisions in time was used to study cascades in Cu and Au at primary kinetic energies up to 100 keV. Nonlinearities were approximated by letting already-stopped cascade atoms become targets in later collisions, using an improved method of locating potential targets to extend the calculations to energies much higher than heretofore. Beside the effect of the approximate nonlinearity, the effect of thermal disorder in the targets was examined. Target redisplacements reduce the damage in Cu by 3\% at most, but in Au they reduce it by amounts up to 20\% at 100 keV. Thermal disorder is also important: by disrupting crystal effects, the damage is reduced significantly.},
	number = {1–4},
	journal = {Nuclear Instruments and Methods in Physics Research Section B: Beam Interactions with Materials and Atoms},
	author = {Robinson, Mark T.},
	year = {1992},
	pages = {396 -- 400},
}

