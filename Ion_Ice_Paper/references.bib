@article{kama_abundant_2019,
	title = {Abundant refractory sulfur in protoplanetary disks},
	url = {https://ui.adsabs.harvard.edu/abs/2019arXiv190805169K/abstract},
	abstract = {Sulfur is one of the most abundant elements in the Universe, with important roles in astro-, geo-, and biochemistry. Its main reservoirs in planet-forming disks have previously eluded detection: gaseous molecules only account for \$\&lt;1{\textbackslash},\${\textbackslash}\% of total elemental sulfur, with the rest likely in either ices or refractory minerals. Mechanisms such as giant planets can filter out dust from gas accreting onto disk-hosting stars. For stars above 1.4 solar masses, this leaves a chemical signature on the stellar photosphere that can be used to determine the fraction of each element that is locked in dust. Here, we present an application of this method to sulfur, zinc, and sodium. We analyse the accretion-contaminated photospheres of a sample of young stars and find \$(89{\textbackslash}pm8){\textbackslash},\${\textbackslash}\% of elemental sulfur is in refractory form in their disks. The main carrier is much more refractory than water ice, consistent with sulfide minerals such as FeS.},
	language = {en},
	urldate = {2019-08-28},
	journal = {arXiv e-prints},
	author = {Kama, Mihkel and Shorttle, Oliver and Jermyn, Adam S. and Folsom, Colin P. and Furuya, Kenji and Bergin, Edwin A. and Walsh, Catherine and Keller, Lindsay},
	month = aug,
	year = {2019},
	pages = {arXiv:1908.05169},
}

@article{zhao_effect_2018,
	title = {Effect of grain size on differential desorption of volatile species and on non-ideal {MHD} diffusivity},
	volume = {478},
	url = {https://ui.adsabs.harvard.edu/abs/2018MNRAS.478.2723Z/abstract},
	doi = {10.1093/mnras/sty1165},
	abstract = {We developed a chemical network for modelling the chemistry and non-ideal magnetohydrodynamic (MHD) effects from the collapsing dense molecular clouds to protostellar discs. First, we reformulated the cosmic-ray desorption rate by considering the variations of desorption rate over the grain size distribution. We find that the differential desorption of volatile species is amplified by the grains larger than 0.1 μm, because larger grains are heated to a lower temperature by cosmic-rays and hence more sensitive to the variations in binding energies. As a result, atomic nitrogen, N, is ̃ two orders of magnitude more abundant than CO; N{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}H{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater} also becomes a few times more abundant than HCO{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater} due to the increased gas-phase N{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}. However, the changes in ionization fraction due to freeze-out and desorption only have minor effects on the non-ideal MHD diffusivities. Our chemical network confirms that the very small grains (below a few 100 Å) weakens the efficiency of both ambipolar diffusion and Hall effect. In collapsing dense cores, a maximum ambipolar diffusion is achieved when truncating the Mathis-Rumpl-Nordsieck size distribution at 0.1 μm, and for a maximum Hall effect, the truncation occurs at 0.04 μm. We conclude that the grain size distribution is crucial to the differential depletion between CO- and N{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}- related molecules as well as to the non-ideal MHD diffusivities in dense cores.},
	language = {en},
	number = {2},
	urldate = {2019-08-26},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Zhao, Bo and Caselli, Paola and Li, Zhi-Yun},
	month = aug,
	year = {2018},
	pages = {2723},
}

@article{fraser_edges_2018,
	title = {The {EDGES} 21 cm anomaly and properties of dark matter},
	volume = {785},
	issn = {0370-2693},
	url = {http://www.sciencedirect.com/science/article/pii/S0370269318306488},
	doi = {10.1016/j.physletb.2018.08.035},
	abstract = {The recently claimed anomaly in the measurement of the 21 cm hydrogen absorption signal by EDGES at z∼17, if cosmological, requires the existence of new physics. The possible attempts to resolve the anomaly rely on either (i) cooling the hydrogen gas via new dark matter-hydrogen interactions or (ii) modifying the soft photon background beyond the standard CMB one, as possibly suggested also by the ARCADE 2 excess. We argue that solutions belonging to the first class are generally in tension with cosmological dark matter probes once simple dark sector models are considered. Therefore, we propose soft photon emission by light dark matter as a natural solution to the 21 cm anomaly, studying a few realizations of this scenario. We find that the signal singles out a photophilic dark matter candidate characterised by an enhanced collective decay mechanism, such as axion mini-clusters.},
	urldate = {2019-08-26},
	journal = {Physics Letters B},
	author = {Fraser, Sean and Hektor, Andi and Hütsi, Gert and Kannike, Kristjan and Marzo, Carlo and Marzola, Luca and Racioppi, Antonio and Raidal, Martti and Spethmann, Christian and Vaskonen, Ville and Veermäe, Hardi},
	month = oct,
	year = {2018},
	keywords = {Axions, Cosmology, Dark matter, Hydrogen gas, Photon background},
	pages = {159--164},
}

@article{loeffler_photolysis_2013,
	title = {Photolysis of {H2O}–{H2O2} mixtures: {The} destruction of {H2O2}},
	volume = {226},
	issn = {0019-1035},
	shorttitle = {Photolysis of {H2O}–{H2O2} mixtures},
	url = {http://www.sciencedirect.com/science/article/pii/S0019103513002959},
	doi = {10.1016/j.icarus.2013.06.030},
	abstract = {We present laboratory results on the loss of H2O2 in solid H2O+H2O2 mixtures at temperatures between 21 and 145K initiated by UV photolysis (193nm). Using infrared spectroscopy and microbalance gravimetry, we measured the decrease of the 3.5μm infrared absorption band during UV irradiation and obtained a photodestruction cross section that varies with temperature, being lowest at 70K. We use our results, along with our previously measured H2O2 production rates via ionizing radiation and ion energy fluxes from the spacecraft to compare H2O2 creation and destruction at icy satellites by ions from their planetary magnetosphere and from solar UV photons. We conclude that, in many cases, H2O2 is not observed on icy satellite surfaces because the H2O2 photodestruction rate is much higher than the production rate via energetic particles, effectively keeping the H2O2 infrared signature at or below the noise level.},
	number = {1},
	urldate = {2019-08-16},
