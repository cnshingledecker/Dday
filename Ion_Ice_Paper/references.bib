@article{cernicharo_sulfur_1987,
	title = {Sulfur in {IRC} + 10216},
	volume = {181},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1987A%26A...181L...9C},
	abstract = {The authors report the detection of 12 lines of C2S and 11 lines of C3S in IRC +10216. These lines, which sample a large range of rotational energies, yield accurate values of these species' column densities. The abundances of C2S and C3S are compared to those of other sulfur molecules and carbon chains. C2S and C3S are a factor of ≈40 less abundant than CS, but about as abundant as C5H and C6H, two carbon chain radicals of similar weight. The detection of these
molecules and of H2S shows that sulfur chemistry in
circumstellar envelopes is more interesting than previously thought.},
	urldate = {2017-10-06},
	journal = {Astronomy and Astrophysics},
	author = {Cernicharo, J. and Kahane, C. and Guelin, M. and Hein, H.},
	month = jul,
	year = {1987},
