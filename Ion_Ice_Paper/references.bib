	author = {Hincelin, U. and Wakelam, V. and Commerçon, B. and Hersant, F. and Guilloteau, S.},
	month = sep,
	year = {2013},
	keywords = {ISM: abundances, ISM: molecules, astrochemistry, magnetohydrodynamics: MHD, protoplanetary disks, stars: formation},
