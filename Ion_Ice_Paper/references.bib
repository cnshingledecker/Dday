@article{hacar_hcn--hnc_2020,
	title = {{HCN}-to-{HNC} intensity ratio: a new chemical thermometer for the molecular {ISM}},
	volume = {635},
	copyright = {© ESO 2020},
	issn = {0004-6361, 1432-0746},
	shorttitle = {{HCN}-to-{HNC} intensity ratio},
	url = {https://www.aanda.org/articles/aa/abs/2020/03/aa36516-19/aa36516-19.html},
	doi = {10.1051/0004-6361/201936516},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} The gas kinetic temperature ({\textless}i{\textgreater}T{\textless}i/{\textgreater}{\textless}sub{\textgreater}K{\textless}sub/{\textgreater}) determines the physical and chemical evolution of the interstellar medium (ISM). However, obtaining reliable {\textless}i{\textgreater}T{\textless}i/{\textgreater}{\textless}sub{\textgreater}K{\textless}sub/{\textgreater} estimates usually requires expensive observations including the combination of multi-line analysis and dedicated radiative transfer calculations.{\textless}i{\textgreater}Aims.{\textless}i/{\textgreater} This work explores the use of HCN and HNC observations, and particularly the {\textless}i{\textgreater}I{\textless}i/{\textgreater}(HCN)-to-{\textless}i{\textgreater}I{\textless}i/{\textgreater}(HNC) intensity ratio ({\textless}i{\textgreater}I{\textless}i/{\textgreater}(HCN)/{\textless}i{\textgreater}I{\textless}i/{\textgreater}(HNC)) of their {\textless}i{\textgreater}J{\textless}i/{\textgreater} = 1–0 lines, as direct probe of the gas kinetic temperature in the molecular ISM.{\textless}i{\textgreater}Methods.{\textless}i/{\textgreater} We obtained a new set of large-scale observations of the HCN and HNC (1–0) lines throughout the Integral Shape Filament (ISF) in Orion. In combination with ancillary gas and dust temperature measurements, we find a systematic temperature dependence of the observed {\textless}i{\textgreater}I{\textless}i/{\textgreater}(HCN)-to-{\textless}i{\textgreater}I{\textless}i/{\textgreater}(HNC) intensity ratio throughout our maps. Additional comparisons with chemical models demonstrate that these observed {\textless}i{\textgreater}I{\textless}i/{\textgreater}(HCN)/{\textless}i{\textgreater}I{\textless}i/{\textgreater}(HNC) variations are driven by the effective destruction and isomerization mechanisms of HNC under low-energy barriers.{\textless}i{\textgreater}Results.{\textless}i/{\textgreater} The observed variations of {\textless}i{\textgreater}I{\textless}i/{\textgreater}(HCN)/{\textless}i{\textgreater}I{\textless}i/{\textgreater}(HNC) with {\textless}i{\textgreater}T{\textless}i/{\textgreater}{\textless}sub{\textgreater}K{\textless}sub/{\textgreater} can be described with a two-part linear function. This empirical calibration is then used to create a temperature map of the entire ISF. Comparisons with similar dust temperature measurements in this cloud, as well as in other regions and galactic surveys, validate this simple technique for obtaining direct estimates of the gas kinetic temperature in a wide range of physical conditions and scales with an optimal working range between 15 K ≲ {\textless}i{\textgreater}T{\textless}i/{\textgreater}{\textless}sub{\textgreater}K{\textless}sub/{\textgreater} ≤ 40 K.{\textless}i{\textgreater}Conclusions.{\textless}i/{\textgreater} Both observations and models demonstrate the strong sensitivity of the {\textless}i{\textgreater}I{\textless}i/{\textgreater}(HCN)/{\textless}i{\textgreater}I{\textless}i/{\textgreater}(HNC) ratio to the gas kinetic temperature. Since these lines are easily obtained in observations of local and extragalactic sources, our results highlight the potential use of this observable as new chemical thermometer for the ISM.},
	language = {en},
	urldate = {2020-04-08},
	journal = {Astronomy \& Astrophysics},
	author = {Hacar, A. and Bosman, A. D. and Dishoeck, E. F. van},
	month = mar,
	year = {2020},
	pages = {A4},
}

@article{graninger_hnchcn_2014,
	title = {The {HNC}/{HCN} {Ratio} in {Star}-forming {Regions}},
	volume = {787},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2014ApJ...787...74G},
	doi = {10.1088/0004-637X/787/1/74},
	abstract = {HNC and HCN, typically used as dense gas tracers in molecular clouds, are a pair of isomers that have great potential as a temperature probe because of temperature dependent, isomer-specific formation and
destruction pathways. Previous observations of the HNC/HCN abundance ratio show that the ratio decreases with increasing temperature, something that standard astrochemical models cannot reproduce. We have undertaken a detailed parameter study on which environmental
characteristics and chemical reactions affect the HNC/HCN ratio and can thus contribute to the observed dependence. Using existing gas and gas-grain models updated with new reactions and reaction barriers, we find that in static models the H + HNC gas-phase reaction regulates the HNC/HCN ratio under all conditions, except for very early times. We quantitatively constrain the combinations of H abundance and H + HNC reaction barrier that can explain the observed HNC/HCN temperature dependence and discuss the implications in light of new quantum chemical calculations. In warm-up models, gas-grain chemistry contributes significantly to the predicted HNC/HCN ratio and understanding the dynamics of star formation is therefore key to model the HNC/HCN system.},
	urldate = {2020-04-08},
	journal = {The Astrophysical Journal},
	author = {Graninger, Dawn M. and Herbst, Eric and Öberg, Karin I. and Vasyunin, Anton I.},
	month = may,
	year = {2014},
	keywords = {ISM: molecules, astrochemistry, stars: formation},
	pages = {74},
}

@article{ghesquiere_diffusion_2015,
	title = {Diffusion of molecules in the bulk of a low density amorphous ice from molecular dynamics simulations},
	volume = {17},
	issn = {1463-9084},
	url = {https://pubs.rsc.org/en/content/articlelanding/2015/cp/c5cp00558b},
	doi = {10.1039/C5CP00558B},
	abstract = {The diffusion of molecules in interstellar ice is a fundamental phenomenon to take into account while studying the formation of complex molecules in this ice. This work presents a theoretical study on the diffusion of H2O, NH3, CO2, CO, and H2CO in the bulk of a low density amorphous (LDA) ice, while taking into account the physical conditions prevailing in space, i.e. temperatures below 150 K and extremely low pressure. This study was undertaken by means of molecular dynamics simulations. For CO2 for which no experimental data were available we conducted our own experiments. From our calculations we show that, at low temperatures, the diffusion of molecules in the bulk of a LDA ice is driven by the self-diffusion of water molecules in the ice. With this study we demonstrate that molecular dynamics allows the calculation of diffusion coefficients for small molecules in LDA ice that are convincingly comparable to experimentally measured diffusion coefficients. We also provide diffusion coefficients for a series of molecules of astrochemical interest.},
	language = {en},
	number = {17},
	urldate = {2020-03-31},
	journal = {Physical Chemistry Chemical Physics},
	author = {Ghesquière, P. and Mineva, T. and Talbi, D. and Theulé, P. and Noble, J. A. and Chiavassa, T.},
	month = apr,
	year = {2015},
	pages = {11455--11468},
}

@article{ivlev_gas_2019,
	title = {Gas and {Dust} {Temperature} in {Prestellar} {Cores} {Revisited}: {New} {Limits} on {Cosmic}-{Ray} {Ionization} {Rate}},
	volume = {884},
	issn = {0004-637X},
	shorttitle = {Gas and {Dust} {Temperature} in {Prestellar} {Cores} {Revisited}},
	url = {https://doi.org/10.3847%2F1538-4357%2Fab4252},
	doi = {10.3847/1538-4357/ab4252},
	abstract = {We develop a self-consistent model for the equilibrium gas temperature and size-dependent dust temperature in cold, dense, prestellar cores, assuming an arbitrary power-law size distribution of dust grains. Compact analytical expressions applicable to a broad range of physical parameters are derived and compared with predictions of the commonly used standard model. It is suggested that combining the theoretical results with observations should allow us to constrain the degree of dust evolution and the cosmic-ray ionization rate in dense cores, and to help with discriminating between different regimes of cosmic-ray transport in molecular clouds. In particular, assuming a canonical MRN distribution of grain sizes, our theory demonstrates that the gas-temperature measurements in the prestellar core L1544 are consistent with an ionization rate as high as ∼10−16 s−1, an order of magnitude higher than previously thought.},
	language = {en},
	number = {2},
	urldate = {2020-03-30},
	journal = {The Astrophysical Journal},
	author = {Ivlev, Alexei V. and Silsbee, Kedron and Sipilä, Olli and Caselli, Paola},
	month = oct,
	year = {2019},
	pages = {176},
}

@article{wakelam_binding_2017,
	title = {Binding energies: {New} values and impact on the efficiency of chemical desorption},
	volume = {6},
	issn = {2405-6758},
	shorttitle = {Binding energies},
	url = {http://www.sciencedirect.com/science/article/pii/S240567581630032X},
	doi = {10.1016/j.molap.2017.01.002},
	abstract = {Recent laboratory measurements have confirmed that chemical desorption (desorption of products due to exothermic surface reactions) can be an efficient process. The impact of including this process into gas-grain chemical models entirely depends on the formalism used and the associated parameters. Among these parameters, binding energies are probably the most uncertain ones for the moment. We propose a new model to compute binding energy of species to water ice surfaces. We have also compared the model results using either the new chemical desorption model proposed by Minissale et al. (2016) or the one of Garrod et al. (2007). The new binding energies have a strong impact on the formation of complex organic molecules. In addition, the new chemical desorption model from Minissale produces a much smaller desorption of these species and also of methanol. Combining the two effects, the abundances of CH3OH and COMs observed in cold cores cannot be reproduced by astrochemical models anymore.},
	language = {en},
	urldate = {2020-03-30},
	journal = {Molecular Astrophysics},
	author = {Wakelam, V. and Loison, J. -C. and Mereau, R. and Ruaud, M.},
	month = mar,
	year = {2017},
	keywords = {Astrochemistry, ISM: abundances, ISM: molecules},
	pages = {22--35},
}

