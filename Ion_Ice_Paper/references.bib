@article{brunken_interstellar_2010,
	title = {Interstellar {HOCN} in the {Galactic} center region},
	volume = {516},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/2010A%26A...516A.109B},
	doi = {10.1051/0004-6361/200912456},
	abstract = {Aims: Our aim is to confirm the interstellar detection of cyanic acid, HOCN, in the Galactic center clouds. It has previously been tentatively detected only in Sgr B2(OH). Methods: We used a complete line survey of the hot cores Sgr B2(N) and (M) in the 3 mm range, complemented by additional observations carried out with the IRAM 30 m telescope at selected frequencies in the 2 mm band and towards four additional positions in the Sgr B2 cloud complex in the 2 and 3 mm bands. The spectral survey was analysed in the local thermodynamical equilibrium approximation (LTE) by modeling the emission of all
identified molecules simultaneously. This allowed us to distinguish weak features of HOCN from the rich line spectrum observed in Sgr B2(N) and (M). Lines of the more stable (by 1.1 eV) isomer isocyanic acid, HNCO, in these sources, as well as those of HOCN and HNCO towards the other positions, were analysed in the LTE approximation as well. Results: Four transitions of HOCN were detected in a quiescent molecular cloud in the Galactic center at a position offset in (RA, Dec) by (20”, 100”) from the hot core source Sgr B2(M), confirming
its previous tentative interstellar detection. Up to four transitions were detected toward five other positions in the Sgr B2 complex, including the hot cores Sgr B2(M), (S), and (N). A fairly constant abundance ratio of {\textasciitilde}0.3-0.8\% for HOCN relative to HNCO was derived for the extended gas components, suggesting a common formation process of these isomers.

Based on observations with the IRAM 30-m telescope. IRAM is supported by CNRS/INSU (France), the MPG (Germany) and the IGN (Spain).},
	urldate = {2017-10-09},
	journal = {Astronomy and Astrophysics},
	author = {Brünken, S. and Belloche, A. and Martín, S. and Verheyen, L. and Menten, K. M.},
	month = jun,
	year = {2010},
	keywords = {ISM: abundances, ISM: individual objects: Sagittarius B2, astrochemistry, line: identification, radio lines: ISM, stars: formation},
	pages = {A109},
}

@article{brunken_laboratory_2009,
	title = {Laboratory {Detection} of {HOCN} and {Tentative} {Identification} in {Sgr} {B2}},
	volume = {697},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2009ApJ...697..880B},
	doi = {10.1088/0004-637X/697/1/880},
	abstract = {The rotational spectrum of cyanic acid, HOCN, has been detected in the centimeter-wave band in a molecular beam by Fourier transform microwave spectroscopy and in the millimeter-wave band by conventional
spectroscopy in a low-pressure laboratory discharge. Spectroscopic constants, including the nitrogen hyperfine coupling constant, derived from 31 a-type transitions between 21 and 360 GHz with J up to 17 and Ka {\textless}= 2 allow the spectrum in the only rotational ladders populated in the interstellar gas to be calculated well into the submillimeter-wave band to 1 km s-1 or better in equivalent radial velocity. Four consecutive transitions of HOCN between 83.9 and 146.8 GHz were tentatively identified in published spectral line surveys of Sgr B2(OH). An approximate column density in Sgr B2(OH) of 6 × 1012 cm-2 implies that the HOCN/HNCO ratio is about 0.5\%. Because HNCO is widely distributed in the interstellar gas, HOCN may be as well.},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal},
	author = {Brünken, S. and Gottlieb, C. A. and McCarthy, M. C. and Thaddeus, P.},
	month = may,
	year = {2009},
	keywords = {ISM: individual: Sgr B2, ISM: molecules, line: identification, molecular data, molecular processes, radio lines: ISM},
	pages = {880--885},
}

@article{tenenbaum_millimeter_2009,
	title = {Millimeter {Detection} of {AlO} ({X} {2Σ}+): {Metal} {Oxide} {Chemistry} in the {Envelope} of {VY} {Canis} {Majoris}},
	volume = {694},
	issn = {0004-637X},
	shorttitle = {Millimeter {Detection} of {AlO} ({X} {2Σ}+)},
	url = {http://adsabs.harvard.edu/abs/2009ApJ...694L..59T},
	doi = {10.1088/0004-637X/694/1/L59},
	abstract = {A new circumstellar molecule, the radical AlO (X 
2Σ+), has been detected toward the envelope
of the oxygen-rich supergiant star VY Canis Majoris (VY CMa) using the
Arizona Radio Observatory (ARO). The N = 7 → 6 and 6 → 5
rotational transitions of AlO at 268 and 230 GHz were observed at 1 mm
using the ARO Submillimeter Telescope (SMT) and the N = 4 → 3 line
was detected at 2 mm using the ARO 12 m telescope. Based on the shape of
the line profiles, AlO most likely arises from the dust-forming region
in the spherical outflow of VY CMa, as opposed to the blue or redshifted
winds, with a source size of θ s {\textasciitilde} 0farcs5. Given this
source size, the column density of AlO was found to be N tot
{\textasciitilde} 2 × 1015 cm-2 for T rot {\textasciitilde} 230
K, with a fractional abundance, relative to H2, of
{\textasciitilde}10-8. Gas-phase thermodynamic equilibrium chemistry is the
likely formation mechanism for AlO in VY CMa, but either shocks disrupt
the condensation process into Al2O3, or chemical
"freezeout" occurs. The species therefore survives further into the
circumstellar envelope to a radius of r {\textasciitilde} 20 R *. The
detection of AlO in VY CMa is additional evidence of an active gas-phase
refractory chemistry in oxygen-rich envelopes, and suggests such objects
may be fruitful sources for other new oxide identifications.},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {Tenenbaum, E. D. and Ziurys, L. M.},
	month = mar,
	year = {2009},
	keywords = {ISM: molecules, astrochemistry, circumstellar matter, radio lines: stars, stars: individual: VY CMa},
	pages = {L59--L63},
}

@article{marcelino_discovery_2009,
	title = {Discovery of {Fulminic} {Acid}, {HCNO}, in {Dark} {Clouds}},
	volume = {690},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2009ApJ...690L..27M},
	doi = {10.1088/0004-637X/690/1/L27},
	abstract = {We report on the first detection in space of fulminic acid, HCNO. This isomer of HNCO has been observed in three starless cores, B1, L1544, and L183, and in the low-mass star-forming region L1527 with a measured abundance ratio of HNCO/HCNO between 40 and 70. However, HCNO was not detected toward the direction of the cyanopolyyne peak of TMC-1 or toward the Orion Hot Core region. The derived HNCO/HCNO abundance ratio in these cases is greater than 350 and 1000 in TMC-1 and Orion,
respectively. We find that CH2 + NO → HCNO + H is a key reaction for the formation of fulminic acid. A value of 5.5 ×
10-12 cm3 s-1 of the corresponding reaction rate coefficient, as given by Miller et al., allows us to reproduce the observed abundances of fulminic acid in both the observed dark clouds and low-mass star-forming core, where the determined abundance of HNCO in these regions with respect to molecular hydrogen is 1-5 × 10-10.

This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {Marcelino, Núria and Cernicharo, José and Tercero, Belén and Roueff, Evelyne},
	month = jan,
	year = {2009},
	keywords = {ISM: abundances, ISM: clouds, ISM: molecules, astrochemistry, line: identification},
	pages = {L27--L30},
}

@article{cernicharo_detection_2008,
	title = {Detection of {C5N}- and {Vibrationally} {Excited} {C6H} in {IRC} +10216},
	volume = {688},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2008ApJ...688L..83C},
	doi = {10.1086/595583},
	abstract = {We report the detection in the envelope of the C-rich star IRC +10216 of four series of lines with harmonically related frequencies: B1389, B1390, B1394, and B1401. The four series must arise from linear
molecules with mass and size close to those of C6H and C5N. Three of the series have half-integer rotational quantum numbers; we assign them to the 2Δ and
2Σ- vibronic states of C6H
in its lowest (ν11) bending mode. The fourth series,
B1389, has integer J with no evidence of fine or hyperfine structure; it has a rotational constant of 1388.860(2) MHz and a centrifugal
distortion constant of 33(1) Hz; it is almost certainly the
C5N- anion.

Based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {Cernicharo, J. and Guélin, M. and Agúndez, M. and McCarthy, M. C. and Thaddeus, P.},
	month = dec,
	year = {2008},
	keywords = {ISM: molecules, circumstellar matter, radio lines: ISM, stars: AGB and post-AGB, stars: individual: IRC +10216},
	pages = {L83},
}

@article{tenenbaum_search_2008,
	title = {A {Search} for {Phosphine} in {Circumstellar} {Envelopes}: {PH3} in {IRC} +10216 and {CRL} 2688?},
	volume = {680},
	issn = {0004-637X},
	shorttitle = {A {Search} for {Phosphine} in {Circumstellar} {Envelopes}},
	url = {http://adsabs.harvard.edu/abs/2008ApJ...680L.121T},
	doi = {10.1086/589973},
	abstract = {We present the results of a search for the JK = 
10→ 00 transition of PH3
(phosphine) at 267 GHz toward several circumstellar envelopes using the
Arizona Radio Observatory 10 m Submillimeter Telescope (SMT). In the
carbon-rich shells of IRC +10216 and CRL 2688, we have detected emission
lines exactly at the PH3 frequency. Toward the oxygen-rich
supergiant VY Canis Majoris, only an upper limit was obtained, while in
the evolved carbon-rich proto-planetary nebula CRL 618, the transition
is contaminated by vibrationally excited HC3N
(ν7 = 4). The line shape in IRC +10216 appears to consist
of two distinct components: a flat-topped profile with a width of {\textasciitilde}28 km
s-1, as is typical for this source, and a narrower
feature approximately 4 km s-1 wide. The narrow
component likely arises from the inner envelope (r {\textless} 8R*)
where the gas has not reached the terminal expansion velocity, or it is
nonthermal emission. Based on the broader component, the abundance of
PH3 with respect to H2 is estimated to be 5
× 10-8 in a region with a radius of r {\textless}
150R*. If the narrower component is thermal, it implies a
phosphine abundance of {\textasciitilde}5 × 10-7 close to the
stellar photosphere (r {\textless} 8R*). In CRL 2688, the
PH3 abundance is less constrained, with plausible values
ranging from 3 × 10-8 to 4 ×
10-7, assuming a spherical distribution. Phosphine
appears to be present in large concentrations in the inner envelope of
C-rich AGB stars, and thus may function as a parent molecule for other
phosphorus species.},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {Tenenbaum, E. D. and Ziurys, L. M.},
	month = jun,
	year = {2008},
	keywords = {ISM: molecules, astrochemistry, circumstellar matter, radio lines: stars, stars: individual: CRL 2688 IRC +10216},
	pages = {L121},
}

