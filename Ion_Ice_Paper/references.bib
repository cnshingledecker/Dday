	keywords = {1072, 1667, Astrophysics - Astrophysics of Galaxies, Astrophysics - Solar and Stellar Astrophysics},
	pages = {59},
}

@article{sita_discovery_2022,
	title = {Discovery of {Interstellar} 2-{Cyanoindene} (2-{C}₉{H}₇{CN}) in {GOTHAM} {Observations} of {TMC}-1},
	volume = {938},
