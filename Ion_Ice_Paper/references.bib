	keywords = {Astronomical Spectroscopy, Astrophysics, Centimeter Waves, Distance Measuring Equipment, Error Analysis, Galactic Structure, Galaxies, H Lines, Red Shift, Spectral Line Width, Velocity Distribution},
	pages = {4--20},
}

