@article{allodi_nonlinear_2015,
	title = {Nonlinear terahertz coherent excitation of vibrational modes of liquids},
	volume = {143},
	url = {https://ui.adsabs.harvard.edu/abs/2015JChPh.143w4204A/abstract},
	doi = {10.1063/1.4938165},
	abstract = {We report the first coherent excitation of intramolecular vibrational modes via the nonlinear interaction of a TeraHertz (THz) light field with molecular liquids. A terahertz-terahertz-Raman pulse sequence prepares the coherences with a broadband, high-energy, (sub)picosecond terahertz pulse, that are then measured in a terahertz Kerr effect spectrometer via phase-sensitive, heterodyne detection with an optical pulse. The spectrometer reported here has broader terahertz frequency coverage, and an increased sensitivity relative to previously reported terahertz Kerr effect experiments. Vibrational coherences are observed in liquid diiodomethane at 3.66 THz (122 cm{\textless}SUP{\textgreater}-1{\textless}/SUP{\textgreater}), and in carbon tetrachloride at 6.50 THz (217 cm{\textless}SUP{\textgreater}-1{\textless}/SUP{\textgreater}), in exact agreement with literature values of those intramolecular modes. This work opens the door to 2D spectroscopies, nonlinear in terahertz field, that can study the dynamics of condensed-phase molecular systems, as well as coherent control at terahertz frequencies.},
	language = {en},
	number = {23},
	urldate = {2019-09-07},
	journal = {Journal of Chemical Physics},
	author = {Allodi, Marco A. and Finneran, Ian A. and Blake, Geoffrey A.},
	month = dec,
	year = {2015},
	pages = {234204},
}

@article{mcguire_thz_2016,
	title = {{THz} time-domain spectroscopy of mixed {CO2}-{CH3OH} interstellar ice analogs},
	volume = {18},
	url = {https://ui.adsabs.harvard.edu/abs/2016PCCP...1820199M/abstract},
	doi = {10.1039/C6CP00632A},
	abstract = {The icy mantles of interstellar dust grains are the birthplaces of the primordial prebiotic molecular inventory that may eventually seed nascent solar systems and the planets and planetesimals that form therein. Here, we present a study of two of the most abundant species in these ices after water: carbon dioxide (CO2) and methanol (CH3OH) using TeraHertz (THz) time-domain spectroscopy and mid-infrared spectroscopy. We study pure and mixed-ices of these species, and demonstrate the power of the THz region of the spectrum to elucidate the long-range structure (i.e. crystalline versus amorphous) of the ice, the degree of segregation of these species within the ice, and the thermal history of the species within the ice. Finally, we comment on the utility of the THz transitions arising from these ices for use in astronomical observations of interstellar ices.},
	language = {en},
	number = {30},
	urldate = {2019-09-07},
	journal = {Physical Chemistry Chemical Physics (Incorporating Faraday Transactions)},
	author = {McGuire, Brett A. and Ioppolo, Sergio and Allodi, Marco A. and Blake, Geoffrey A.},
	year = {2016},
	pages = {20199},
}

@article{finneran_decade-spanning_2015,
	title = {Decade-{Spanning} {High}-{Precision} {Terahertz} {Frequency} {Comb}},
	volume = {114},
	url = {https://ui.adsabs.harvard.edu/abs/2015PhRvL.114p3902F/abstract},
	doi = {10.1103/PhysRevLett.114.163902},
	abstract = {The generation and detection of a decade-spanning terahertz (THz) frequency comb is reported using two Ti:sapphire femtosecond laser oscillators and asynchronous optical sampling THz time-domain spectroscopy. The comb extends from 0.15 to 2.4 THz, with a tooth spacing of 80 MHz, a linewidth of 3.7 kHz, and a fractional precision of 1.8 ×10{\textless}SUP{\textgreater}-9{\textless}/SUP{\textgreater} . With time-domain detection of the comb, we measure three transitions of water vapor at 10 mTorr between 1-2 THz with an average Doppler-limited fractional accuracy of 6.1 ×10{\textless}SUP{\textgreater}-8{\textless}/SUP{\textgreater} . Significant improvements in bandwidth, resolution, and sensitivity are possible with existing technologies.},
	language = {en},
	number = {16},
	urldate = {2019-09-07},
	journal = {Physical Review Letters},
	author = {Finneran, Ian A. and Good, Jacob T. and Holland, Daniel B. and Carroll, P. Brandon and Allodi, Marco A. and Blake, Geoffrey A.},
	month = apr,
	year = {2015},
	pages = {163902},
}

