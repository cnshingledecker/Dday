@article{cernicharo_tmc-1_2021,
	title = {{TMC}-1, the starless core sulfur factory: {Discovery} of {NCS}, {HCCS}, {H2CCS}, {H2CCCS}, and {C4S} and detection of {C5S}},
	volume = {648},
	copyright = {© ESO 2021},
	issn = {0004-6361, 1432-0746},
	shorttitle = {{TMC}-1, the starless core sulfur factory},
	url = {https://www.aanda.org/articles/aa/abs/2021/04/aa40642-21/aa40642-21.html},
	doi = {10.1051/0004-6361/202140642},
	abstract = {We report the detection of the sulfur-bearing species NCS, HCCS, H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}CCS, H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}CCCS, and C{\textless}sub{\textgreater}4{\textless}sub/{\textgreater}S for the first time in space. These molecules were found towards TMC-1 through the observation of several lines for each species. We also report the detection of C{\textless}sub{\textgreater}5{\textless}sub/{\textgreater}S for the first time in a cold cloud through the observation of five lines in the 31–50 GHz range. The derived column densities are {\textless}i{\textgreater}N{\textless}i/{\textgreater}(NCS) = (7.8 ± 0.6) × 10{\textless}sup{\textgreater}11{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}−2{\textless}sup/{\textgreater}, {\textless}i{\textgreater}N{\textless}i/{\textgreater}(HCCS) = (6.8 ± 0.6) × 10{\textless}sup{\textgreater}11{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}−2{\textless}sup/{\textgreater}, {\textless}i{\textgreater}N{\textless}i/{\textgreater}(H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}CCS) = (7.8 ± 0.8) × 10{\textless}sup{\textgreater}11{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}−2{\textless}sup/{\textgreater}, {\textless}i{\textgreater}N{\textless}i/{\textgreater}(H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}CCCS) = (3.7 ± 0.4) × 10{\textless}sup{\textgreater}11{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}−2{\textless}sup/{\textgreater}, {\textless}i{\textgreater}N{\textless}i/{\textgreater}(C{\textless}sub{\textgreater}4{\textless}sub/{\textgreater}S) = (3.8 ± 0.4) × 10{\textless}sup{\textgreater}10{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}−2{\textless}sup/{\textgreater}, and {\textless}i{\textgreater}N{\textless}i/{\textgreater}(C{\textless}sub{\textgreater}5{\textless}sub/{\textgreater}S) = (5.0 ± 1.0) × 10{\textless}sup{\textgreater}10{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}−2{\textless}sup/{\textgreater}. The observed abundance ratio between C{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}S and C{\textless}sub{\textgreater}4{\textless}sub/{\textgreater}S is 340, that is to say a factor of approximately one hundred larger than the corresponding value for CCS and C{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}S. The observational results are compared with a state-of-the-art chemical model, which is only partially successful in reproducing the observed abundances. These detections underline the need to improve chemical networks dealing with S-bearing species.},
	language = {en},
	urldate = {2021-09-23},
	journal = {Astronomy \& Astrophysics},
	publisher = {EDP Sciences},
	author = {Cernicharo, J. and Cabezas, C. and Agúndez, M. and Tercero, B. and Pardo, J. R. and Marcelino, N. and Gallego, J. D. and Tercero, F. and López-Pérez, J. A. and Vicente, P. de},
	month = apr,
	year = {2021},
	pages = {L3},
}

@article{mullikin_new_2021,
	title = {A {New} {Method} for {Simulating} {Photoprocesses} in {Astrochemical} {Models}},
	volume = {910},
	issn = {0004-637X},
	url = {https://doi.org/10.3847/1538-4357/abd778},
	doi = {10.3847/1538-4357/abd778},
	abstract = {We propose a new model for treating solid-phase photoprocesses in interstellar ice analogs. In this approach, photoionization and photoexcitation are included in more detail, and the production of electronically excited (suprathermal) species is explicitly considered. In addition, we have included nonthermal, nondiffusive chemistry to account for the low-temperature characteristic of cold cores. As an initial test of our method, we have simulated two previous experimental studies involving the UV irradiation of pure solid O2. In contrast to previous solid-state astrochemical model calculations, which have used gas-phase photoabsorption cross-sections, we have employed solid-state cross-sections in our calculations. This method allows the model to be tested using well-constrained experiments rather than poorly constrained gas-phase abundances in interstellar medium regions. Our results indicate that inclusion of nonthermal reactions and suprathermal species allows for reproduction of low-temperature solid-phase photoprocessing that simulates interstellar ices within cold (∼10 K) dense cores such as TMC-1.},
	language = {en},
	number = {1},
	urldate = {2021-09-08},
	journal = {The Astrophysical Journal},
	author = {Mullikin, Ella and Anderson, Hannah and O'Hern, Natalie and Farrah, Megan and Arumainayagam, Christopher R. and Dishoeck, Ewine F. van and Gerakines, Perry A. and Vasyunin, Anton I. and Majumdar, Liton and Caselli, Paola and Shingledecker, Christopher N.},
	month = mar,
	year = {2021},
	pages = {72},
}

@article{ramage_ratzinger_2021,
	title = {Ratzinger on {Evolution} and {Evil}: {A} {Christological} and {Mariological} {Answer} to the {Problem} of {Suffering} and {Death} in {Creation}},
	volume = {12},
	copyright = {http://creativecommons.org/licenses/by/3.0/},
	shorttitle = {Ratzinger on {Evolution} and {Evil}},
	url = {https://www.mdpi.com/2077-1444/12/8/583},
	doi = {10.3390/rel12080583},
	abstract = {This article argues that a compelling way to address the presence of suffering and death across evolutionary history lies in the thought of Joseph Ratzinger/Pope Benedict XVI. By situating human evolution within the broader divine plan for man’s salvation through the cross of Jesus, Ratzinger is able to show that the presence of natural evils in this world is not incompatible with God’s goodness but on the contrary is an eminent means by which the love of God is made manifest. Exploring Christ’s kenosis and the sinless suffering of the Blessed Virgin, it is argued that suffering properly embraced is the raw material for love and thus essential for true human flourishing in this life. The real problem for man, it is contended, is not having to suffer and die, but how to suffer and die well. Finally, it is suggested that the full Christian answer to the problem of suffering connected with evolution nevertheless lies in the eschatogical hope for a new heaven and new earth, where man—and all creation with him—will undergo a definitive “evolutionary leap” of “transubstantiation” in Christ.},
	language = {en},
	number = {8},
	urldate = {2021-08-07},
	journal = {Religions},
	author = {Ramage, Matthew J.},
	month = aug,
	year = {2021},
	keywords = {Mariology, Ratzinger, death, eschatology, evil, evolution, kenosis, love, suffering, theodicy},
	pages = {583},
}

