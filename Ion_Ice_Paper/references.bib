}

@incollection{eley_catalytic_1948,
	title = {The {Catalytic} {Activation} of {Hydrogen}},
	volume = {1},
	url = {https://www.sciencedirect.com/science/article/pii/S0360056408606756},
	doi = {10.1016/S0360-0564(08)60675-6},
	abstract = {The mechanism of the catalytic activation of hydrogen gas and of hydrogen in organic compounds is of importance for numerous industrial processes and for the problem of biological oxidation. This chapter describes the experimental studies of chemisorbed hydrogen on metals, theoretical studies of chemisorbed hydrogen on metals, production of hydrogen atoms by hot tungsten, recombination of hydrogen atoms, the parahydrogen conversion, the exchange of atoms between deuterium gas and hydrides, exchange and hydrogenation of unsaturated hydrocarbons, the Fischer–Tropsch synthesis, dehydrogenation, cyclization of n-paraffins, the hydrogen-oxygen reaction, and biological activation of hydrogen. The three types of catalysts discussed in the chapter possess common energy levels—that is, the valency electrons of the atoms are not localized but may move through the lattice. Metals are electronic conductors, and certain of the catalytic oxides—for example, nickel oxide, are known “semiconductors.”},
