	keywords = {Abundance, Carbon Compounds, Extragalactic Radio Sources, Interstellar Matter, Microwave Spectra, Molecular Chains, Quantum Mechanics, Silicides, Silicon Compounds, Spectrum Analysis, Stellar Envelopes},
	pages = {L83--L86},
