@article{garozzo_fate_2010,
	title = {The fate of {S}-bearing species after ion irradiation of interstellar icy grain mantles},
	volume = {509},
	copyright = {© ESO, 2010},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2010/01/aa13040-09/aa13040-09.html},
	doi = {10.1051/0004-6361/200913040},
	abstract = {{\textless}i{\textgreater}Context. {\textless}i/{\textgreater}Chemical models predict the presence of S-bearing molecules such as hydrogen sulfide (H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S) in interstellar icy grain mantles in dense molecular clouds. Up to now only two S-bearing molecules, namely sulfur dioxide (SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}) and carbonyl sulfide (OCS), have been detected in the solid phase towards young stellar objects (YSOs), while upper limits for solid H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S have been reported towards the same lines of sight. The estimated abundance of S-bearing molecules in icy grain mantles is not able to account for the cosmic S abundance.{\textless}i{\textgreater}Aims. {\textless}i/{\textgreater}In this paper we studied the effects of ion irradiation on different icy targets formed by carbon monoxide (CO) and SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} or H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S as mixtures and, for the first time, as layers.{\textless}i{\textgreater}Methods. {\textless}i/{\textgreater}We carried out several irradiation experiments on ices containing SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} or H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S mixed or layered with CO. The samples were irradiated with 200 keV protons in a high-vacuum chamber ( mbar) at a temperature of 16–20 K. IR spectra of the samples were recorded after various steps of irradiation and after warm-up.{\textless}i{\textgreater}Results. {\textless}i/{\textgreater}We have found that the column density of H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S and SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, as well as CO, decreases after irradiation, and the formation of new molecular species is observed. In the case of CO:SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} samples, OCS, sulfur trioxide (SO{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}), ozone (O{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}), and carbon dioxide (CO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}) are the most abundant species formed. In the case of CO:H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S samples the most abundant species formed are OCS, SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, carbon disulfide (CS{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}), hydrogen persulfide (H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}), and CO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}. The profile of the OCS band formed after irradiation of the CO:H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S mixture compares well with the profile of the OCS band detected towards the high mass YSO W33A.{\textless}i{\textgreater}Conclusions. {\textless}i/{\textgreater}Our results show that on a time scale comparable to the molecular cloud lifetime, the column density of H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S is strongly reduced and we suggest that this could explain the failure of its detection in the solid phase in the lines of sight of YSOs. We suggest that the solid OCS and SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} detected in dense molecular clouds are formed after ion irradiation of icy grain mantles.},
	language = {en},
	urldate = {2018-09-25},
	journal = {Astronomy \& Astrophysics},
	author = {Garozzo, M. and Fulvio, D. and Kanuchova, Z. and Palumbo, M. E. and Strazzulla, G.},
	month = jan,
	year = {2010},
	pages = {A67},
}

@article{ferrante_formation_2008,
	title = {Formation of {Interstellar} {OCS}: {Radiation} {Chemistry} and {IR} {Spectra} of {Precursor} {Ices}},
	volume = {684},
	issn = {0004-637X},
	shorttitle = {Formation of {Interstellar} {OCS}},
	url = {http://adsabs.harvard.edu/abs/2008ApJ...684.1210F},
	doi = {10.1086/590362},
	abstract = {Extensive experimental studies have been performed on the solid-state 
formation of the OCS molecule in proton-irradiated water-free and
water-dominated ices containing CO or CO2 as the carbon
source and H2S or SO2 as the sulfur source. In
each case OCS is readily formed. Production efficiency follows the
trends CO {\textgreater} CO2 and H2S {\textgreater} SO2 as
C,O- and S-sources, respectively. In water-dominated ices, OCS
production appears to be enhanced for CO : H2S reactants. The
mechanism of formation of OCS appears to be the reaction of CO with free
S atoms produced by fragmentation of the sulfur parent species. While
OCS is readily formed by irradiation, it is also the most easily
destroyed on continued exposure. In H2O-dominated ices the
half-life of H2S, SO2, and OCS is {\textasciitilde}2 eV
molecule-1, corresponding to {\textasciitilde}7 million years in a cold dense
interstellar cloud environment processed by cosmic-ray protons. The
spectral profile of the ν3 band of OCS is highly dependent
on temperature and ice composition, and changes with radiation
processing. These effects can be used in theoretical modeling of
interstellar infrared (IR) spectra; a laboratory spectrum of irradiated
H2O : CO : H2S, warmed to 50 K, provides a good
fit to the 2040 cm-1 feature in the W33A spectrum. The
identification of OCS in CO2-dominated ices provides a
further challenge, due to the overlap of the OCS band with that of
CO3 formed from irradiation of the host ice. The two features
can be unraveled by a curve-fitting procedure. It is the width of the
2040 cm-1 band that will help observers determine if features
identified in CO2-rich ices are due to OCS or to
CO3.},
	urldate = {2018-09-25},
	journal = {The Astrophysical Journal},
	author = {Ferrante, Robert F. and Moore, Marla H. and Spiliotis, Morgan M. and Hudson, Reggie L.},
	month = sep,
	year = {2008},
	keywords = {ISM: molecules, astrochemistry, methods: laboratory, techniques: spectroscopic},
	pages = {1210--1220},
}

@article{jimenez-escobar_sulfur_2011,
	title = {Sulfur depletion in dense clouds and circumstellar regions. {I}. {H2S} ice abundance and {UV}-photochemical reactions in the {H2O}-matrix},
	volume = {536},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/2011A%26A...536A..91J},
	doi = {10.1051/0004-6361/201014821},
	abstract = {Aims: This work aims to study the unexplained sulfur depletion 
observed toward dense clouds and protostars. Methods: We made
simulation experiments of the UV-photoprocessing and sublimation of
H2S and H2S:H2O ice in dense clouds and
circumstellar regions, using the InterStellar Astrochemistry Chamber
(ISAC), a state-of-the-art ultra-high-vacuum setup. The ice was
monitored in situ by mid-infrared spectroscopy in transmittance.
Temperature-programmed desorption (TPD) of the ice was performed using a
quadrupole mass spectrometer (QMS) to detect the volatiles desorbing
from the ice. Results: Comparing our laboratory data to infrared
observations of protostars we obtained a more accurate upper limit of
the abundance of H2S ice toward these objects. We determined
the desorption temperature of H2S ice, which depends on the
initial H2S:H2O ratio. UV-photoprocessing of
H2S:H2O ice led to the formation of several
species. Among them, H2S2 was found to
photodissociate forming S2 and, by elongation, other species
up to S8, which are refractory at room temperature. A large
fraction of the missing sulfur in dense clouds and circumstellar regions
could thus be polymeric sulfur residing in dust grains.},
	urldate = {2018-09-25},
	journal = {Astronomy and Astrophysics},
	author = {Jiménez-Escobar, A. and Muñoz Caro, G. M.},
	month = dec,
	year = {2011},
	keywords = {ISM: molecules, dust, extinction, infrared: ISM, methods: laboratory, ultraviolet: ISM},
	pages = {A91},
}

@article{jimenez-escobar_soft_2012,
	title = {Soft {X}-{Ray} {Irradiation} of {H2S} {Ice} and the {Presence} of {S2} in {Comets}},
	volume = {751},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2012ApJ...751L..40J},
	doi = {10.1088/2041-8205/751/2/L40},
	abstract = {Little is known about the effects of X-rays in interstellar ices. To understand the sulfur depletion in dense clouds and the presence of S2 in comets, we simulated experimentally the soft X-ray processing (0.3 keV) of H2S ice for the first time.
Experiments were performed under ultrahigh vacuum conditions at 8 K using infrared and quadrupole mass spectrometry to monitor the solid and gas phases, respectively. A UV irradiation experiment using a similar dose was made for comparison. After X-ray irradiation, an infrared absorption appears near 4.0 μm which is attributed to
H2S2 formation in the ice. This identification is also supported by the desorption at 133 K of m/z 66, 65, 64,
corresponding to the mass fragments of H2S2. The H2S2 species is expected to be present in
interstellar and cometary ices that were processed by X-rays. Further irradiation leads to dissociation of this molecule forming S2 and larger S-molecules up to S8, which may explain the depletion of sulfur in dense clouds. CS2 was so far the parent molecule proposed for S2 formation in comets. But the abundance of H2S2, formed by irradiation of pure H2S or H2S in an H2O-ice matrix, should be larger than that of CS2 in the ice, the latter requiring a carbon source for its formation. Based on our experimental results, we propose that S2 in comets could be formed by dissociation of H2S2 in the ice.},
	urldate = {2018-09-25},
	journal = {The Astrophysical Journal Letters},
	author = {Jiménez-Escobar, A. and Muñoz Caro, G. M. and Ciaravella, A. and Cecchi-Pestellini, C. and Candia, R. and Micela, G.},
	month = jun,
	year = {2012},
	keywords = {ISM: molecules, X-rays: ISM, methods: laboratory},
	pages = {L40},
}

@article{green_analytic_1972,
	title = {Analytic models of electron impact excitation cross sections},
	volume = {34},
	issn = {0021-9169},
	url = {http://www.sciencedirect.com/science/article/pii/002191697290030X},
	doi = {10.1016/0021-9169(72)90030-X},
	abstract = {We present a number of analytic forms which have been used to represent electron impact excitation cross sections all the way from threshold to the high energy domain where they join approximately to the results of the Born-Bethe approximation. Techniques for estimating the parameters in these analytic forms are described in detail so that the reader can update his own parameter set when new experimental information becomes available. A short collection of parameters for excitations to key states of N2, O2 and O is given along with references to sources where more complete sets are available. The importance of analytic models as a means of communication to aeronomical users of cross sections is discussed.},
	number = {10},
	urldate = {2018-09-25},
	journal = {Journal of Atmospheric and Terrestrial Physics},
	author = {Green, A. E. S. and Stolarski, R. S.},
	month = oct,
	year = {1972},
	pages = {1703--1717},
}

