@article{jing_formation_2012,
	title = {Formation of {Molecular} {Oxygen} and {Ozone} on {Amorphous} {Silicates}},
	volume = {756},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/2012ApJ...756...98J},
	doi = {10.1088/0004-637X/756/1/98},
	abstract = {Oxygen in the interstellar medium is seen in the gas phase, in ices (incorporated in H2O, CO, and CO2), and in grains such as (Mg x Fe1- x
)SiO3 or (Mg x Fe1- x )2SiO4, 0 {\textless} x {\textless} 1. In this investigation, we study the diffusion of oxygen atoms and the formation of oxygen
molecules and ozone on the surface of an amorphous silicate film. We find that ozone is formed at low temperature ({\textless}30 K), and molecular oxygen forms when the diffusion of oxygen atoms becomes significant, at around 60 K. This experiment, besides being the first determination of the diffusion energy barrier (1785 ± 35 K) for oxygen atoms on a silicate surface, suggests bare silicates as a possible storage place for oxygen atoms in low-Av environments.},
	urldate = {2019-01-23},
	journal = {The Astrophysical Journal},
	author = {Jing, Dapeng and He, Jiao and Brucato, John Robert and Vidali, Gianfranco and Tozzetti, Lorenzo and De Sio, Antonio},
	month = sep,
	year = {2012},
	keywords = {ISM: molecules, astrochemistry, dust, extinction, methods: laboratory, molecular processes},
	pages = {98},
}

@article{he_new_2015,
	title = {A {New} {Determination} of the {Binding} {Energy} of {Atomic} {Oxygen} {On} {Dust} {Grain} {Surfaces}: {Experimental} {Results} and {Simulations}},
	volume = {801},
	issn = {0004-637X},
	shorttitle = {A {New} {Determination} of the {Binding} {Energy} of {Atomic} {Oxygen} {On} {Dust} {Grain} {Surfaces}},
	url = {http://adsabs.harvard.edu/abs/2015ApJ...801..120H},
	doi = {10.1088/0004-637X/801/2/120},
	abstract = {The energy to desorb atomic oxygen from an interstellar dust grain 
surface, Edes, is an important controlling parameter in
gas-grain models; its value impacts the temperature range over which
oxygen resides on a dust grain. However, no prior measurement has been
done of the desorption energy. We report the first direct measurement of
Edes for atomic oxygen from dust grain analogs. The values of
Edes are 1660 ± 60 and 1850 ± 90 K for porous
amorphous water ice and for a bare amorphous silicate film,
respectively, or about twice the value previously adopted in simulations
of the chemical evolution of a cloud. We use the new values to study
oxygen chemistry as a function of depth in a molecular cloud. For n =
104 cm-3 and G0 = 102
(G0 = 1 is the average local interstellar radiation field),
the main result of the adoption of the higher oxygen binding energy is
that H2O can form on grains at lower visual extinction
AV, closer to the cloud surface. A higher binding energy of O
results in more formation of OH and H2O on grains, which are
subsequently desorbed by far-ultraviolet radiation, with consequences
for gas-phase chemistry. For higher values of n and G0, the
higher binding energy can lead to a large increase in the column of
H2O but a decrease in the column of O2.},
	urldate = {2019-01-23},
	journal = {The Astrophysical Journal},
	author = {He, Jiao and Shi, Jianming and Hopkins, Tyler and Vidali, Gianfranco and Kaufman, Michael J.},
	month = mar,
	year = {2015},
	keywords = {ISM: abundances, ISM: atoms, ISM: molecules, astrochemistry, dust, extinction},
	pages = {120},
}

@article{uehara_calculations_2000,
