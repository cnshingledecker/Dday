}

@article{wakelam_proposed_2015,
	title = {A proposed chemical scheme for {HCCO} formation in cold dense clouds},
	volume = {453},
	issn = {0035-8711},
	url = {http://adsabs.harvard.edu/abs/2015MNRAS.453L..48W},
	doi = {10.1093/mnrasl/slv097},
	abstract = {The ketenyl radical (HCCO) has recently been discovered in two cold dense clouds with a non-negligible abundance of a few 10-11 (compared to H2). Until now, no chemical network has been able to reproduce this observation. We propose here a chemical scheme that can reproduce HCCO abundances together with HCO, H2CCO and CH3CHO in the dark clouds Lupus-1A and L486. The main formation pathway for HCCO is the OH + CCH → HCCO + H reaction as suggested by Agúndez et al. but with a much larger rate
coefficient than used in current models. Since this reaction has never been studied experimentally or theoretically, this larger value is based on a comparison with other similar systems.},
	urldate = {2018-11-02},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Wakelam, V. and Loison, J.-C. and Hickson, K. M. and Ruaud, M.},
	month = oct,
	year = {2015},
	keywords = {ISM: abundances, ISM: clouds, ISM: molecules, astrochemistry},
	pages = {L48--L52},
}

