@article{kuiper_detection_1975,
	title = {Detection of 2.6-millimeter radiation probably due to nitrogen sulfide},
	volume = {200},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1975ApJ...200L.151K},
	doi = {10.1086/181919},
	abstract = {Results are reported for observations of millimeter-wavelength radiation in Sgr B2 at two frequencies corresponding to the transitions between the J = 5/2 and J = 3/2 Lambda-doublet sublevels in the 2 Pi(1/2) state of nitrogen sulfide. Difficulties in making a positive identification of the source of this radiation are discussed which result from the apparently anomalous ratio of the hyperfine components. However, it is noted that observations of the d-state by Gottlieb et al. (1975) showing the hyperfine components more exactly in their optically thin ratio confirm that the observed radiation is due to nitrogen sulfide.},
	urldate = {2017-10-06},
	journal = {The Astrophysical Journal Letters},
	author = {Kuiper, T. B. H. and Kakar, R. K. and Rodriguez Kuiper, E. N. and Zuckerman, B.},
