@article{atkinson_evaluated_2007,
	title = {Evaluated kinetic and photochemical data for atmospheric chemistry: {Volume} {III} - gas phase reactions of inorganic halogens},
	volume = {7},
	issn = {1680-73671680-73241680-7316},
	shorttitle = {Evaluated kinetic and photochemical data for atmospheric chemistry},
