	abstract = {We present the discovery in TMC-1 of vinyl acetylene, CH{\textbackslash}textlesssub{\textbackslash}textgreater2{\textbackslash}textlesssub/{\textbackslash}textgreaterCHCCH, and the detection, for the first time in a cold dark cloud, of HCCN, HC{\textbackslash}textlesssub{\textbackslash}textgreater4{\textbackslash}textlesssub/{\textbackslash}textgreaterN, and CH{\textbackslash}textlesssub{\textbackslash}textgreater3{\textbackslash}textlesssub/{\textbackslash}textgreaterCH{\textbackslash}textlesssub{\textbackslash}textgreater2{\textbackslash}textlesssub/{\textbackslash}textgreaterCN. A tentative detection of CH{\textbackslash}textlesssub{\textbackslash}textgreater3{\textbackslash}textlesssub/{\textbackslash}textgreaterCH{\textbackslash}textlesssub{\textbackslash}textgreater2{\textbackslash}textlesssub/{\textbackslash}textgreaterCCH is also reported. The column density of vinyl acetylene is (1.2 ± 0.2) × 10{\textbackslash}textlesssup{\textbackslash}textgreater13{\textbackslash}textlesssup/{\textbackslash}textgreater cm{\textbackslash}textlesssup{\textbackslash}textgreater−2{\textbackslash}textlesssup/{\textbackslash}textgreater, which makes it one of the most abundant closed-shell hydrocarbons detected in TMC-1. Its abundance is only three times lower than that of propylene, CH{\textbackslash}textlesssub{\textbackslash}textgreater3{\textbackslash}textlesssub/{\textbackslash}textgreaterCHCH{\textbackslash}textlesssub{\textbackslash}textgreater2{\textbackslash}textlesssub/{\textbackslash}textgreater. The column densities derived for HCCN and HC{\textbackslash}textlesssub{\textbackslash}textgreater4{\textbackslash}textlesssub/{\textbackslash}textgreaterN are (4.4 ± 04) × 10{\textbackslash}textlesssup{\textbackslash}textgreater11{\textbackslash}textlesssup/{\textbackslash}textgreater cm{\textbackslash}textlesssup{\textbackslash}textgreater−2{\textbackslash}textlesssup/{\textbackslash}textgreater and (3.7 ± 0.4) × 10{\textbackslash}textlesssup{\textbackslash}textgreater11{\textbackslash}textlesssup/{\textbackslash}textgreater cm{\textbackslash}textlesssup{\textbackslash}textgreater−2{\textbackslash}textlesssup/{\textbackslash}textgreater, respectively. Hence, the HCCN/HC{\textbackslash}textlesssub{\textbackslash}textgreater4{\textbackslash}textlesssub/{\textbackslash}textgreaterN abundance ratio is 1.2 ± 0.3. For ethyl cyanide we derive a column density of (1.1 ± 0.3) × 10{\textbackslash}textlesssup{\textbackslash}textgreater11{\textbackslash}textlesssup/{\textbackslash}textgreater cm{\textbackslash}textlesssup{\textbackslash}textgreater−2{\textbackslash}textlesssup/{\textbackslash}textgreater. These results are compared with a state-of-the-art chemical model of TMC-1, which is able to account for the observed abundances of these molecules through gas-phase chemical routes.},
	language = {en},
	urldate = {2021-03-17},
