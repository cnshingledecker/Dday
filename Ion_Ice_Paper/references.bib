	pages = {1319--1322},
}

@article{cernicharo_tentative_1988,
	title = {Tentative detection of {CH3NC} towards {SGR} {B2}},
	volume = {189},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1988A%26A...189L...1C},
	abstract = {This paper reports on the tentative discovery of CH3NC in Sgr Br made during May, August, and October 1986, and March 1987 observations with the IRAM 30-m telescope equipped with 2- and 3-mm SIS receivers with DSB noise temperature of 150 and 100 K. The spectra observed in Sgr B2(OH) displayed three broadened lines, identified with the frequencies of the J = 4-3, J = 5-4, and J = 7-6 transitions, characteristic of methyl isocyanide. Assuming that these lines do arise from CH3NC, the
CH3NC/CH3CN abundance ratio is estimated to be about 0.05. Although the frequency of the J = 5-4 transition line is close to that of the J = 4-3 transition of NaOH, no signal was found at the frequencies of the J = 3-2, J = 5-4, and J = 6-5 transitions of NaOH.},
