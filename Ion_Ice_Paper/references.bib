@article{mcguire_detection_2017,
	title = {Detection of {Interstellar} {HC5O} in {TMC}-1 with the {Green} {Bank} {Telescope}},
	volume = {843},
	issn = {2041-8205},
	url = {http://stacks.iop.org/2041-8205/843/i=2/a=L28},
	doi = {10.3847/2041-8213/aa7ca3},
	abstract = {We report the detection of the carbon-chain radical HC 5 O for the first time in the interstellar medium toward the cold core TMC-1 using the 100 m Green Bank Telescope. We observe four hyperfine components of this radical in the \#\#IMG\#\# [http://ej.iop.org/images/2041-8205/843/2/L28/apjlaa7ca3ieqn1.gif] \$J=17/2{\textbackslash}to 15/2\$ rotational transition that originates from the \#\#IMG\#\# [http://ej.iop.org/images/2041-8205/843/2/L28/apjlaa7ca3ieqn2.gif] \${\textasciicircum}2{\textbackslash}rm{\textbackslash}Pi \_1/2\$ fine structure level of its ground state and calculate an abundance of \#\#IMG\#\# [http://ej.iop.org/images/2041-8205/843/2/L28/apjlaa7ca3ieqn3.gif] \$n/n\_H\_2=1.7{\textbackslash}times 10{\textasciicircum}-10\$ , assuming an excitation temperature of \#\#IMG\#\# [http://ej.iop.org/images/2041-8205/843/2/L28/apjlaa7ca3ieqn4.gif] \$T\_{\textbackslash}mathrmex=7\$ K. No indication of HC 3 O, HC 4 O, or HC 6 O, is found in these or archival observations of the source, while we report tentative evidence for HC 7 O. We compare calculated upper limits and the abundance of HC 5 O to predictions based on (1) the abundance trend of the analogous HC n N family in TMC-1 and (2) a gas-grain chemical model. We find that the gas-grain chemical model well reproduces the observed abundance of HC 5 O, as well as the upper limits of HC 3 O, HC 6 O, and HC 7 O, but HC 4 O is overproduced. The prospects for astronomical detection of both shorter and longer HC n O chains are discussed.},
	language = {en},
	number = {2},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {McGuire, Brett A. and Burkhardt, Andrew M. and Shingledecker, Christopher N. and Kalenskii, Sergei V. and {Eric Herbst} and Remijan, Anthony J. and McCarthy, Michael C.},
	year = {2017},
	pages = {L28},
}

