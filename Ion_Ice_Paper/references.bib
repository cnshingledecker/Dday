@article{saito_laboratory_1987,
	title = {Laboratory detection and astronomical identification of a new free radical, {CCS} {3Sigma}/-/},
	volume = {317},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1987ApJ...317L.115S},
	doi = {10.1086/184923},
	abstract = {The linear CCS radical has been detected, for the first time, by 
laboratory microwave spectroscopy, and four unidentified lines including
the U45379 line from TMC-1 and seven from Sgr B2 have been assigned to
the transitions of this radical. The radical was produced in a
free-space absorption cell by a dc glow discharge in a mixture of CS2
and He. Twenty-nine lines were observed in the frequency region up to
300 HGz and were least-squares analyzed to determine the detailed
molecular constants. Two strong unidentified lines, U45379 and U22344,
were assigned to the F1 components, J(N) = 4(3)-3(2) and 2(1)-1(0),
respectively. The J(N) = 2(1)-1(0) transition of CC(S-34) was also
observed in TMC-1. The column densities of CCS in Sgr B2 and TMC-1 are
estimated to be (6 + or - 1) x 10 to the 13th and (8 + or - 2) x 10 to
the 13th per sq cm, respectively.},
	urldate = {2017-10-06},
	journal = {The Astrophysical Journal Letters},
	author = {Saito, Shuji and Kawaguchi, Kentarou and Yamamoto, Satoshi and Ohishi, Masatoshi and Suzuki, Hiroko and Kaifu, N.},
	month = jun,
	year = {1987},
	keywords = {Astronomical Spectroscopy, Carbon Compounds, Carbon Disulfide, Free Radicals, Gas Mixtures, Interstellar Matter, Line Spectra, Microwave Spectra, Molecular Energy Levels, Molecular Rotation, Sulfides},
	pages = {L115--L118},
}

@article{hollis_interstellar_1986,
	title = {An interstellar line coincident with the {P}(2,1) transition of hydronium ({H3O}+)},
	volume = {322},
	issn = {0028-0836},
	url = {http://adsabs.harvard.edu/abs/1986Natur.322..524H},
	doi = {10.1038/322524a0},
	abstract = {Double-sideband observations of the Orion KL nebular region with the NRAO 12 m radiotelescope in March 1986 detected a weak emission spectral line that coincided with the P(2,1) rotation-inversion transition of H3O+. Spectral maps are provided for the observed line at 307,192 MHz with 2 and 1 MHz resolution. The line parameters, along with a
calculated transition dipole moment of 1.44 D, are used to estimate column densities of 7.7 and 8.7 x 10 to the 13/sq cm for excitation temperatures of 50 and 90 K, respectively. A minimum H2 density of 1 million/cu cm is estimated for the region if the thermalization of the transition to the excitation temperatures is to occur. Finally,
fractional abundances of H2O in the Orion cloud are projected to be 1/100,000 and 1/1 million for the nonthermal and thermal transition cases, respectively.},
	urldate = {2017-10-06},
	journal = {Nature},
	author = {Hollis, J. M. and Churchwell, E. B. and Herbst, E. and De Lucia, F. C.},
	month = aug,
	year = {1986},
	keywords = {Electron Recombination, Electron Transitions, Hydronium Ions, Interstellar Chemistry, Interstellar Gas, Line Spectra, Molecular Clouds, Orion Nebula, Thermalization (Energy Absorption)},
	pages = {524--526},
}

@article{wootten_search_1986,
	title = {A search for interstellar {H3O}(+)},
	volume = {166},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1986A%26A...166L..15W},
	abstract = {The P(2,1) line of H3O+, a key species in ion-molecule chemistry, has been sought in the interstellar medium and in Halley's Comet. In OMC1 and Sgr B2, a line was detected which may possibly be attributed to H3O+. Verification of this identification must be accomplished through observation of the P(3,2) line at 364 GHz, or detection of isotopic variants. If the detected line arises from H3O+, it could be possible to deduce a fractional abundance X(H3O+) in OMC1 and in Sgr B2 of ≡10-9 and a production rate in Comet Halley of Q(H3O+) {\textless}
1028s-1. These results would place
H3O+ among the more abundant molecular ions in the interstellar gas in agreement with theoretical predictions.},
	urldate = {2017-10-06},
	journal = {Astronomy and Astrophysics},
	author = {Wootten, A. and Boulanger, F. and Bogey, M. and Combes, F. and Encrenaz, P. J. and Gerin, M. and Ziurys, L.},
	month = sep,
	year = {1986},
	keywords = {Abundance, Halley'S Comet, Interstellar Gas, Line Spectra, Molecular Ions, Positive Ions, Water},
	pages = {L15--L18},
}

@article{cernicharo_detection_1986,
	title = {Detection of the {2Pi3}/2 state of {C5H}},
	volume = {167},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1986A%26A...167L...5C},
	abstract = {The authors report the detection in the molecular envelope of IRC +10216 of four doublets of the 2Π3/2 ladder of
C5H, a new radical recently discovered by Cernicharo et al. (1986). From the line intensities they derive rotational temperatures of 14 and 24K for the 2Π1/2 and
2Π3/2 ladders respectively. The C5H column density, averaged over a 25arcsec beam, is found to be about few ×1013cm-2. The abundance ratio
