@article{kolesnikova_spectroscopic_2014,
	title = {Spectroscopic {Characterization} and {Detection} of {Ethyl} {Mercaptan} in {Orion}},
	volume = {784},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2014ApJ...784L...7K},
	doi = {10.1088/2041-8205/784/1/L7},
	abstract = {New laboratory data of ethyl mercaptan, CH3CH2SH, in the millimeter- and submillimeter-wave domains (up to 880 GHz) provided very precise values of the spectroscopic constants that allowed the detection of gauche-CH3CH2SH toward Orion KL. This identification is supported by 77 unblended or slightly blended lines plus no missing transitions in the range 80-280 GHz. A detection of methyl mercaptan, CH3SH, in the spectral survey of Orion KL is reported as well. Our column density results indicate that methyl mercaptan is sime 5 times more abundant than ethyl mercaptan in the hot core of Orion KL. This work was based on observations carried out with the IRAM 30 m telescope. IRAM is supported by INSU/CNRS (France), MPG (Germany), and IGN (Spain).},
	urldate = {2022-05-18},
	journal = {The Astrophysical Journal},
	author = {Kolesniková, L. and Tercero, B. and Cernicharo, J. and Alonso, J. L. and Daly, A. M. and Gordon, B. P. and Shipman, S. T.},
	month = mar,
	year = {2014},
	note = {ADS Bibcode: 2014ApJ...784L...7K},
	keywords = {Astrophysics - Astrophysics of Galaxies, ISM: abundances, ISM: individual objects: Orion KL, ISM: molecules, line: identification},
	pages = {L7},
}

@article{irvine_observations_1989,
	title = {Observations of {Some} {Oxygen}-containing and {Sulfur}-containing {Organic} {Molecules} in {Cold} {Dark} {Clouds}},
	volume = {342},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/1989ApJ...342..871I},
	doi = {10.1086/167643},
	abstract = {Observations of nine oxygen- and sulfur-containing organic molecules have been made toward the cold dark clouds TMC-1 and L134N. The presence of paraketene (H2C2O) in TMC-1 is confirmed for orthoketene, and has been observed for the first time and a total ketene column density of about 10 to the 13th/sq cm is found. Thioformaldehyde (H2CS) is easily detectable in both TMC-1 and L134N, with a column density about five times larger in the former source. The fractional abundance of ketene is comparable to the predictions of ion-molecule chemistry, while that of thioformaldehyde in TMC-1 is one to two orders of magnitude greater than that expected from such models at steady state. Interstellar sulfur chemistry thus continues to be poorly understood. Upper limits are set for the column densities of formic acid (HCOOH), vinyl alcohol (CH2CHOH), methyl formate (HCO2CH3), formamide (NH2CHO), methyl mercaptan (CH3SH), isothiocyanic acid (HNCS), and thioketene (H2C2S) in both sources.},
	urldate = {2022-05-18},
	journal = {The Astrophysical Journal},
	author = {Irvine, W. M. and Friberg, P. and Kaifu, N. and Kawaguchi, K. and Kitamura, Y. and Matthews, H. E. and Minh, Y. and Saito, S. and Ukita, N. and Yamamoto, S.},
	month = jul,
	year = {1989},
	note = {ADS Bibcode: 1989ApJ...342..871I},
	keywords = {Astrophysics, Formaldehyde, Formic Acid, INTERSTELLAR: ABUNDANCES, INTERSTELLAR: MOLECULES, Interstellar Chemistry, Interstellar Matter, Ketenes, LINE IDENTIFICATIONS, MOLECULAR PROCESSES, Methyl Compounds, Molecular Clouds, Organic Sulfur Compounds, Oxygen Compounds},
	pages = {871},
}

