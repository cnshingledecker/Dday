@incollection{redington_matrix_1996,
	address = {Dordrecht},
	title = {Matrix {Perturbation} of {Vibrational} {Isotope} {Effects}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_8},
	doi = {10.1007/978-94-009-0281-7_8},
	abstract = {Intermolecular potential energy functions associated with the solvation of small molecules affect their chemical reactivity and other properties of general importance. Matrix-isolation sampling can provide prototype solvation conditions for some molecules, and spectroscopic studies can yield matrix-induced vibrational frequency shifts and other resolved data for heavy atom isotopomers. In this discussion vibrational isotope effects for small matrix-isolated molecules [e.g. HCOOH and (LiF)1,2,3,4] are considered with respect to their behavior in different matrices [e.g. Rg, N2, CO, CO2]. A goal for this type of research is an evaluation of the use of the matrix perturbation of isotope effects as a tool for characterizing matrix trapping sites and for exposing important anharmonicities in the vibrational PEF of the solute molecule.},
	language = {en},
	urldate = {2024-09-01},
