@article{schilke_study_1992,
	title = {A study of {HCN}, {HNC} and their isotopometers in {OMC}-1. {I}. {Abundances} and chemistry.},
	volume = {256},
	issn = {0004-6361},
	url = {https://ui.adsabs.harvard.edu/abs/1992A&A...256..595S/abstract},
	abstract = {Observations of HCN, HNC, and DCN in the OMC-1 region were carried out using the IRAM 30-m dish with 25-arcsec angular resolution. In addition, data were obtained towards Orion-KL in the HC(N-15)(1-0) transition, using the IRAM Plateau de Bure Interferometer. It was found that the HCN/HNC abundance ratio is very high (about 80) in the immediate vicinity of Orion-KL, but it declines rapidly in adjacent ridge positions to values of about 5. The DCN/HCN abundance ratio increases from 0.001 in the hot core gas close to the infrared source IRc2, to values in the range 0.01-0.06 in the OMC-1 region. The H(C-13)N/HC(N-15) ratio increases from 5-7 over much of the ridge to roughly 15 close to Orion-IRc2. A comparison of the observations with the predictions of the molecular cloud chemistry yielded reasonable agreement with steady state models.},
	language = {en},
	urldate = {2020-04-08},
	journal = {A\&A},
	author = {Schilke, P. and Walmsley, C. M. and Pineau Des Forets, G. and Roueff, E. and Flower, D. R. and Guilloteau, S.},
	month = mar,
	year = {1992},
	pages = {595--612},
}

