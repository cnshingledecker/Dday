@article{walmsley_complete_2004,
	title = {Complete depletion in prestellar cores},
	volume = {418},
	issn = {0004-6361},
	url = {https://ui.adsabs.harvard.edu/abs/2004A&A...418.1035W/abstract},
	doi = {10.1051/0004-6361:20035718},
	abstract = {We have carried out calculations of ionization equilibrium and deuterium fractionation for conditions appropriate to a completely depleted, low mass pre-protostellar core, where heavy elements such as C, N, and O have vanished from the gas phase and are incorporated in ice mantles frozen on dust grain surfaces. We put particular emphasis on the interpretation of recent observations of H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}D{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater} towards the centre of the prestellar core L 1544 (Caselli et al. {\textbackslash}cite\{Caselli03\}) and also compute the ambipolar diffusion timescale. We consider explicitly the ortho and para forms of H\_2, H{\textless}SUB{\textgreater}3{\textless}/SUB{\textgreater}{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater}, and H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}D{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater}. Our results show that the ionization degree under such conditions depends sensitively on the grain size distribution or, more precisely, on the mean grain surface area per hydrogen nucleus. Depending upon this parameter and upon density, the major ion may be H{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater}, H{\textless}SUB{\textgreater}3{\textless}/SUB{\textgreater}{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater}, or D{\textless}SUB{\textgreater}3{\textless}/SUB{\textgreater}{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater}. We show that the abundance of ortho-H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}D{\textless}SUP{\textgreater}+{\textless}/SUP{\textgreater} observed towards L 1544 can be explained satisfactorily in terms of a complete depletion model and that this species is, as a consequence, an important tracer of the kinematics of prestellar cores. {\textless}P /{\textgreater}Appendices A and B are only available in electronic form at http://www.edpsciences.org},
	language = {en},
	urldate = {2023-02-23},
	journal = {Astronomy and Astrophysics},
	author = {Walmsley, C. M. and Flower, D. R. and Pineau des Forêts, G.},
	month = may,
	year = {2004},
	pages = {1035--1043},
}

@article{caselli_central_2022,
	title = {The {Central} 1000 au of a {Prestellar} {Core} {Revealed} with {ALMA}. {II}. {Almost} {Complete} {Freeze}-out},
	volume = {929},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2022ApJ...929...13C},
	doi = {10.3847/1538-4357/ac5913},
	abstract = {Prestellar cores represent the initial conditions in the process of star and planet formation. Their low temperatures ({\textless}10 K) allow the formation of thick icy dust mantles, which will be partially preserved in future protoplanetary disks, ultimately affecting the chemical composition of planetary systems. Previous observations have shown that carbon- and oxygen-bearing species, in particular CO, are heavily depleted in prestellar cores due to the efficient molecular freeze-out onto the surface of cold dust grains. However, N-bearing species such as NH3 and, in particular, its deuterated isotopologues appear to maintain high abundances where CO molecules are mainly in the solid phase. Thanks to ALMA, we present here the first clear observational evidence of NH2D freeze-out toward the L1544 prestellar core, suggestive of the presence of a "complete depletion zone" within a ≃1800 au radius, in agreement with astrochemical prestellar core model predictions. Our state-of-the-art chemical model coupled with a non-LTE radiative transfer code demonstrates that NH2D becomes mainly incorporated in icy mantles in the central 2000 au and starts freezing out already at ≃7000 au. Radiative transfer effects within the prestellar core cause the NH2D(111 - 101) emission to appear centrally concentrated, with a flattened distribution within the central ≃3000 au, unlike the 1.3 mm dust continuum emission, which shows a clear peak within the central ≃1800 au. This prevented NH2D freeze-out from being detected in previous observations, where the central 1000 au cannot be spatially resolved.},
	urldate = {2023-02-23},
	journal = {The Astrophysical Journal},
	author = {Caselli, Paola and Pineda, Jaime E. and Sipilä, Olli and Zhao, Bo and Redaelli, Elena and Spezzano, Silvia and Maureira, Maria José and Alves, Felipe and Bizzocchi, Luca and Bourke, Tyler L. and Chacón-Tanarro, Ana and Friesen, Rachel and Galli, Daniele and Harju, Jorma and Jiménez-Serra, Izaskun and Keto, Eric and Li, Zhi-Yun and Padovani, Marco and Schmiedeke, Anika and Tafalla, Mario and Vastel, Charlotte},
	month = apr,
	year = {2022},
	note = {ADS Bibcode: 2022ApJ...929...13C},
	keywords = {1335, 75, 847, 849, Astrochemistry, Astrophysics - Astrophysics of Galaxies, Astrophysics - Earth and Planetary Astrophysics, Astrophysics - Solar and Stellar Astrophysics, Interstellar medium, Interstellar molecules, Radiative transfer},
	pages = {13},
}

