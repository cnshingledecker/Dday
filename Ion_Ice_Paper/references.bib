@article{tielens_photodissociation_1985,
	title = {Photodissociation regions. {I}. {Basic} model.},
	volume = {291},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/1985ApJ...291..722T/abstract},
	doi = {10.1086/163111},
	abstract = {A theoretical parameter study of the temperature and chemical structure of dense photodissociation regions and their resultant spectrum is presented. Models are discussed which are relevant not only to the dust and gas between molecular clouds and H II regions, but also apply to any neutral cloud illuminated by intense FUV fluxes. The models relate observed line and continuum emission from these regions to physical parameters such as the gas density and temperature, the elemental and chemical abundances, the local radiation field, and the grain properties. The results are applied to observational data from the OMC-1 region. The model shows that the observed high brightness temperature of the C I 609 microns line can be explained by emission from the C(+)/C/CO transition region. This difference with previous chemical models is due to a higher gas phase elemental abundance of carbon, to the charge exchange reactions of C(+) with S and SiO, and to carbon self-shielding.},
	language = {en},
	urldate = {2019-06-18},
	journal = {The Astrophysical Journal},
	author = {Tielens, A. G. G. M. and Hollenbach, D.},
	month = apr,
	year = {1985},
	pages = {722},
}

@article{hollenbach_water_2009,
	title = {Water, {O}{\textless}{SUB}{\textgreater}2{\textless}/{SUB}{\textgreater}, and {Ice} in {Molecular} {Clouds}},
	volume = {690},
	url = {https://ui.adsabs.harvard.edu/abs/2009ApJ...690.1497H/abstract},
	doi = {10.1088/0004-637X/690/2/1497},
	abstract = {We model the temperature and chemical structure of molecular clouds as a function of depth into the cloud, assuming a cloud of constant density n illuminated by an external far-ultraviolet (FUV; 6 eV \&lt;hν \&lt; 13.6 eV) flux G {\textless}SUB{\textgreater}0{\textless}/SUB{\textgreater} (scaling factor in multiples of the local interstellar field). Extending previous photodissociation region (PDR) models, we include the freezing of species, simple grain surface chemistry, and desorption (including FUV photodesorption) of ices. We also treat the opaque cloud interior with time-dependent chemistry. Here, under certain conditions, gas-phase elemental oxygen freezes out as water ice and the elemental C/O abundance ratio can exceed unity, leading to complex carbon chemistry. Gas-phase H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}O and O{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater} peak in abundance at intermediate depth into the cloud, roughly A{\textless}SUB{\textgreater}V{\textless}/SUB{\textgreater} {\textasciitilde} 3-8 from the surface, the depth proportional to ln(G {\textless}SUB{\textgreater}0{\textless}/SUB{\textgreater}/n). Closer to the surface, molecules are photodissociated. Deeper into the cloud, molecules freeze to grain surfaces. At intermediate depths, PDRs are attenuated by dust extinction, but photodesorption prevents total freeze-out. For G {\textless}SUB{\textgreater}0{\textless}/SUB{\textgreater} \&lt; 500, abundances of H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}O and O{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater} peak at values {\textasciitilde}10{\textless}SUP{\textgreater}-7{\textless}/SUP{\textgreater}, producing columns {\textasciitilde}10{\textless}SUP{\textgreater}15{\textless}/SUP{\textgreater} cm{\textless}SUP{\textgreater}-2{\textless}/SUP{\textgreater}, independent of G {\textless}SUB{\textgreater}0{\textless}/SUB{\textgreater} and n. The peak abundances depend primarily on the product of the photodesorption yield of water ice and the grain surface area per H nucleus. At higher values of G {\textless}SUB{\textgreater}0{\textless}/SUB{\textgreater}, thermal desorption of O atoms from grains slightly enhances the gas-phase H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}O peak abundance and column, whereas the gas-phase O{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater} peak abundance rises to {\textasciitilde}10{\textless}SUP{\textgreater}-5{\textless}/SUP{\textgreater} and the column to {\textasciitilde}2 × 10{\textless}SUP{\textgreater}16{\textless}/SUP{\textgreater} cm{\textless}SUP{\textgreater}-2{\textless}/SUP{\textgreater}. We present simple analytical equations for the abundances as a function of depth, which clarify the dependence on parameters. The models are applied to observations of H{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}O, O{\textless}SUB{\textgreater}2{\textless}/SUB{\textgreater}, and water ice in a number of sources, including B68, NGC 2024, and ρ Oph.},
	language = {en},
	number = {2},
	urldate = {2019-06-18},
	journal = {The Astrophysical Journal},
	author = {Hollenbach, David and Kaufman, Michael J. and Bergin, Edwin A. and Melnick, Gary J.},
	month = jan,
	year = {2009},
	pages = {1497},
}

@article{ligterink_alma-pils_2018,
	title = {The {ALMA}-{PILS} survey: {Stringent} limits on small amines and nitrogen-oxides towards {IRAS} 16293–{2422B}},
	volume = {619},
	copyright = {© ESO 2018},
	issn = {0004-6361, 1432-0746},
	shorttitle = {The {ALMA}-{PILS} survey},
	url = {https://www.aanda.org/articles/aa/abs/2018/11/aa31980-17/aa31980-17.html},
	doi = {10.1051/0004-6361/201731980},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} Hydroxylamine (NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}OH) and methylamine (CH{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}) have both been suggested as precursors to the formation of amino acids and are therefore, of interest to prebiotic chemistry. Their presence in interstellar space and formation mechanisms, however, are not well established.{\textless}i{\textgreater}Aims.{\textless}i/{\textgreater} We aim to detect both amines and their potential precursor molecules NO, N{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}O, and CH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}NH towards the low-mass protostellar binary IRAS 16293–2422, in order to investigate their presence and constrain their interstellar formation mechanisms around a young Sun-like protostar.{\textless}i{\textgreater}Methods.{\textless}i/{\textgreater} ALMA observations from the unbiased, high-angular resolution and sensitivity Protostellar Interferometric Line Survey (PILS) are used. Spectral transitions of the molecules under investigation are searched for with the CASSIS line analysis software.{\textless}i{\textgreater}Results.{\textless}i/{\textgreater} CH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}NH and N{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}O are detected for the first time, towards a low-mass source, the latter molecule through confirmation with the single-dish TIMASSS survey. NO is also detected. CH{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} and NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}OH are not detected and stringent upper limit column densities are determined.{\textless}i{\textgreater}Conclusions.{\textless}i/{\textgreater} The non-detection of CH{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} and NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}OH limits the importance of formation routes to amino acids involving these species. The detection of CH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}NH makes amino acid formation routes starting from this molecule plausible. The low abundances of CH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}NH and CH{\textless}sub{\textgreater}3{\textless}sub/{\textgreater}NH{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} compared to Sgr B2 indicate that different physical conditions influence their formation in low- and high-mass sources.},
	language = {en},
	urldate = {2019-06-18},
	journal = {Astronomy \& Astrophysics},
	author = {Ligterink, N. F. W. and Calcutt, H. and Coutens, A. and Kristensen, L. E. and Bourke, T. L. and Drozdovskaya, M. N. and Müller, H. S. P. and Wampfler, S. F. and Wiel, M. H. D. van der and Dishoeck, E. F. van and Jørgensen, J. K.},
	month = nov,
	year = {2018},
	pages = {A28},
}

