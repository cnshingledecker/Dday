	volume = {209},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1976ApJ...209L.143B},
	doi = {10.1086/182285},
	abstract = {The letter reports observations of the J = 1-0 and J = 8-7 rotational transitions of cyanodiacetylene (HC5N) at the respective frequencies of 2.663 GHz and 21.301 GHz in Sgr B2. A value of -4.12 + or 0.07 MHz for the HC5N quadrupole coupling constant is obtained from the resolved hyperfine splitting of the J = 1-0 transition. Assuming thermal
