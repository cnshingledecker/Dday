@article{bergner_oxygen_2019,
	title = {Oxygen atom reactions with {C2H6}, {C2H4}, and {C2H2} in ices},
	url = {http://arxiv.org/abs/1903.10981},
	abstract = {Oxygen atom addition and insertion reactions may provide a pathway to chemical complexity in ices that are too cold for radicals to diffuse and react. We have studied the ice-phase reactions of photo-produced oxygen atoms with C2 hydrocarbons under ISM-like conditions. The main products of oxygen atom reactions with ethane are ethanol and acetaldehyde; with ethylene are ethylene oxide and acetaldehyde; and with acetylene is ketene. The derived branching ratio from ethane to ethanol is {\textasciitilde}0.74 and from ethylene to ethylene oxide is {\textasciitilde}0.47. For all three hydrocarbons there is evidence of an effectively barrierless reaction with O({\textasciicircum}1D) to form oxygen-bearing organic products; in the case of ethylene, there may be an additional barriered contribution of the ground-state O({\textasciicircum}3P) atom. Thus, oxygen atom reactions with saturated and unsaturated hydrocarbons are a promising pathway to chemical complexity even at very low temperatures where the diffusion of radical species is thermally inaccessible.},
	urldate = {2019-04-02},
	journal = {arXiv:1903.10981 [astro-ph]},
	author = {Bergner, Jennifer B. and Oberg, Karin I. and Rajappan, Mahesh},
	month = mar,
	year = {2019},
	note = {arXiv: 1903.10981},
	keywords = {Astrophysics - Earth and Planetary Astrophysics},
}

