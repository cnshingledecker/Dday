@article{bradley_gas-phase_1971,
	title = {The gas-phase reactions of singlet oxygen atoms with methane},
	volume = {0},
	issn = {0022-4944},
	url = {http://pubs.rsc.org/en/content/articlelanding/1971/j1/j19710000326},
	doi = {10.1039/J19710000326},
	abstract = {The reaction of excited singlet oxygen atoms with methane has been studied by photolysis of N2O–CH4 mixtures with 1849 Å radiation from a low-pressure mercury lamp. The results have been explained by a mechanism involving the insertion of oxygen atoms into the C–H bonds in methane to give vibrationally excited methanol: O*+ CH4→ CH3OH*. A kinetic analysis of the results gave an order-of-magnitude estimate of k15=ca. 3 × 1010 l mol–1 s–1 at room temperature. The results obtained at high methane pressures provide evidence for the nitrous oxide-photosensitized decomposition of methane.},
