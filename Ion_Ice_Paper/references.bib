@incollection{downs_spectroscopy_1996,
	address = {Dordrecht},
	title = {Spectroscopy of {Matrix} {Isolated} {Molecules}. 1. {Principles}, {Procedures} and {Pitfalls}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_1},
	doi = {10.1007/978-94-009-0281-7_1},
	abstract = {Matrix isolation is now a well established method of sampling molecules large and small, of preserving them indefinitely with minimal perturbation at low temperatures, and of presenting them for conventional spectroscopic analysis. The present review surveys the principles and basic strategies of matrix-isolation studies. How the experiments are carried out and the spectroscopic methods used to interrogate the matrix samples are outlined. Vibrational spectroscopy is the principal agency of detection and characterisation, and recent studies of the hydrides GaH2 and GaH3, and of the different oxometal carbonyls trans-O2Mo(CO)4 and η2-O2)Ni(CO)2 illustrate the way in which the stoicheiometry, geometry and other properties of the trapped molecule can be established with confidence. Rotation of the guest molecule is normally inhibited by its matrix cage, thus denying the experimenter access to precise, detailed information about moments of inertia, bond lengths and so on. There are other deficiencies too. For example, the molecule may occupy more than one type of matrix site; matrix-perturbation may cause an appreciable change in the properties of the molecule; impurities may confuse the issue, as may the effects of aggregation of an unsaturated molecule. There may also be spectroscopic snags: spectral features may overlap; it may be far from easy to ascertain that the same molecule is the carrier of more than one type of spectrum; Fermi resonance may bedevil the interpretation of vibrational spectra; and isotopic changes may fail to provide a clearcut criterion of molecular geometry.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Downs, A. J.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {1--43},
}

@incollection{pratt_conformational_1996,
	address = {Dordrecht},
	title = {Conformational {Analysis} by {Laser} {Spectroscopy}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_14},
	doi = {10.1007/978-94-009-0281-7_14},
	abstract = {Supersonic free jet expansion of a large molecule in a rare gas often leads to the isolation of different conformers of the molecule. Often such conformers exhibit distinct optical spectra at vibrational resolution. In this talk, I will show that the specific structures of the different conformers may be determined by skimming the jet, forming a seeded molecular beam, and recording the optical spectra at higher resolution. Experiments of this type expose the underlying rotational structure of the different vibronic bands, making possible the determination of the moments of inertia of the conformer and, by suitable isotopic labeling, its three-dimensional structure. Examples to be discussed include several derivatives of benzene and naphthalene, keto-enol tautomerism in 2-hydroxypyridine and 2-hydroxy-quinoline, octatetraene, stilbene, and diphenylbutadiene, selected van der Waals complexes of aromatic molecules, and several hydrogen-bonded clusters containing H2O and NH3. Connections to the light-induced reactivity of several of these systems also will be made.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Pratt, David W.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {351--369},
}

@incollection{tomkinson_tunneling_1996,
	address = {Dordrecht},
	title = {Tunneling {Spectroscopy} with neutrons},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_16},
	doi = {10.1007/978-94-009-0281-7_16},
	abstract = {When we think of rotation it is natural, from a chemical view point, to consider molecules in the gas phase. At the low densities of a gas there is nothing inhibiting the molecule’s rotations and many of the techniques reported by other authors in this volume will be concerned with the gas phase. In liquids and solids the density is much higher and the interactions of a molecule with its neighbours become very important. The rotational states are quenched and appear as frustrated attempts at molecular reorientation. The molecules oscillate within the rotational potential well occupying quantised, librational, states. Each librational level is degenerate to the number of possible orientations of the oscillator. Such that, for example, in the three-fold rotational well of an ideal methyl group the librational levels would be equivalent in any of the three wells and each level is three-fold degenerate. In this picture the oscillator is entirely confined within the well and molecules can only rotate when thermal excitation provides some oscillators with sufficient energy to pass over the barriers. This is the classical regime and is appropriate for deep wells, high temperatures and heavy oscillators.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Tomkinson, J.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {421--434},
}

@incollection{bauder_pulsed_1996,
	address = {Dordrecht},
	title = {Pulsed {Nozzle} {Fourier} {Transform} {Microwave} {Spectroscopy} {Of} {Weakly} {Bound} {Molecular} {Complexes}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_11},
	doi = {10.1007/978-94-009-0281-7_11},
	abstract = {During the expansion of a rare gas seeded with small amounts of other compounds through a nozzle into vacuum, the translational and rotational degrees of freedom are efficiently cooled to temperatures of a few Kelvin. Thereby weakly bound complexes are formed between the molecules themselves or with the rare gas atoms. Pulsed operation of the nozzle reduces the necessary pumping speed significantly. Pulsed excitation of molecules or molecular complexes by microwave radiation in a Fabry-Pérot cavity induces a macroscopic polarization which decays subsequently. The free induction decay is amplified, down-converted into the radiofrequency range, digitized and stored. The time domain signals coadded from a number of free induction decays is Fourier transformed to reproduce the conventional spectrum in the frequency domain. Because of the very narrow bandwidth of the Fabry-Pérot cavity, the recording of the rotational spectrum over a wider frequency range requires the stepwise change of the exciting microwave frequency. This technique offers very high resolving power combined with high sensitivity.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Bauder, Alfred},
	editor = {Fausto, R.},
	year = {1996},
	pages = {271--289},
}

@incollection{downs_spectroscopy_1996-1,
	address = {Dordrecht},
	title = {Spectroscopy of {Matrix} {Isolated} {Molecules}. 2. {Applications}: {Pointing} the way to {Synthesis} and {Mechanisms} in {Inorganic} and {Organometallic} {Chemistry}},
	isbn = {978-94-009-0281-7},
	shorttitle = {Spectroscopy of {Matrix} {Isolated} {Molecules}. 2. {Applications}},
	url = {https://doi.org/10.1007/978-94-009-0281-7_2},
	doi = {10.1007/978-94-009-0281-7_2},
	abstract = {In the second part of this account of matrix-isolation studies, the emphasis shifts to the applications of the technique. Matrix experiments may be designed with the aim (i) of synthesising new molecules; (ii) of elucidating the mechanisms of chemical changes; (iii) of exploring the chemical, and particularly photochemical, properties of molecules supported in a solid matrix; and (iv) of investigating the physical properties of stable molecules with reference, for example, to the perturbing influence of the matrix environment. Specific case histories of synthetic studies will be developed in more detail than was possible in Part 1; these relate to gallium hydrides, aluminium and gallium monohalides, chlorine oxides, and metal carbonyl derivatives of the type XCr(CO)5, where X = Xe, H2, or C2H4. Mechanistic studies will also be illustrated with reference to the reactions of selected metal atoms with H2 and CH4; the photochemistry of chlorine oxides; and the photooxidation of metal carbonyls. The final section highlights ways in which the matrix-isolation experiment might be developed, and the potential synergy between matrix-isolation and other practical strategies, but involving samples in a fluid phase.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Downs, A. J.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {45--93},
}

@incollection{durig_spectra_1996,
	address = {Dordrecht},
	title = {Spectra of {Plastic} and {Disordered} {Crystals}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_19},
	doi = {10.1007/978-94-009-0281-7_19},
	abstract = {The crystallization of many almost-spherical molecules (called globular molecules) leads to a new phase of matter which has been called [1–8] a “plastic crystal”. Molecules in plastic crystals appear to possess unusual freedom and the positions of the atoms are less definite than usually found for molecular crystals. Consequently, the X-ray diffraction patterns are less well defined so that the patterns may be limited to only a few reflections. Since disorder, which includes thermal motion, in a crystal effects high order reflections more than low order reflections, and since the molecules in plastic crystals have considerable freedom of movement, a plastic crystal characteristically gives a relatively small number of reflections with considerable background scattering [9]. For example, the X-ray diffraction of cyclobutane in its plastic phase has only two reflections [10]. For cyclohexane, a decrease in the number of lines in the diffraction pattern was found with increasing temperature. The plastic phase I usually has a body centered, or face-centered cubic lattice, but there are many exceptions. For example, cyclopentane [11] has a hexagonal lattice, while methanol [12] is orthorombic in phase I.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Durig, J. R. and Durig, Douglas T.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {505--527},
}

@incollection{maes_combined_1996,
	address = {Dordrecht},
	title = {Combined {Matrix}-{Isolation} {FT}-{IR} and {AB} {Initio} 6-31 + + {G}** {Studies} on the {Tautomerism} and {H}-bonding {Properties} of {Nucleic} {Acid} {Bases} and {Simpler} {Model} {Molecules}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_5},
	doi = {10.1007/978-94-009-0281-7_5},
	abstract = {A step-by-step experimental and ab initio 6–31 + + G** research approach has been developed for interpretation of FT-IR spectra of H-bonded complexes of different tautomers of nucleic acid bases. The first step of this procedure involves a detailed study of a large number of relatively simple compounds, each modeling one or more H-bonding sites of cytosine, adenine and guanine. The application of this method is illustrated with the results obtained for the tautomerism of 1-CH3-adenine and 1-CH3-cytosine, and for some H-bonded complexes of imidazole and 4-NH2-pyridine with water. Comparison between the experimental and ab initio calculated parameters for the H-bonded complexes allows some correlations to be established. Apart from practical application of the correlation curves, e.g. interpretation of the complicated FT-IR spectra of H-bonded nucleic acid bases, more fundamental information can also be obtained from die correlations.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Maes, G. H. and Smets, J. and Adamowicz, L.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {147--167},
}

@incollection{salama_low_1996,
	address = {Dordrecht},
	title = {Low temperature spectroscopy: {From} ground to space},
	isbn = {978-94-009-0281-7},
	shorttitle = {Low temperature spectroscopy},
	url = {https://doi.org/10.1007/978-94-009-0281-7_6},
	doi = {10.1007/978-94-009-0281-7_6},
	abstract = {Low temperature molecular spectroscopy represents an essential tool in laboratory astrophysics. This point is illustrated, here, through the case of the diffuse interstellar bands (DIBs), the longest unsolved enigma in astrophysical spectroscopy. Identifying the carriers responsible for these bands is a key element for a correct understanding of the energetic mechanisms governing the origin and evolution of the interstellar medium (ISM). The multidisciplinary approach adopted to address the DIB issue is described through its three components: astronomical observations, laboratory simulations, and theoretical modeling. A special emphasis is given to the experimental results obtained using matrix isolation spectroscopy (MIS). The potential molecular carriers for the DIBs are briefly discussed and a detailed study of the UV-to-NIR absorption spectra of neutral and ionized polycyclic aromatic hydrocarbons (PAHs) -for which the most focused effort to obtain astrophysically relevant laboratory data has been made to date- is presented. It is shown that, in the case of PAHs, small neutral molecules (≤equal to C-atoms) absorb only in the UV and cannot contribute to the known DIBs although they may contribute to the interstellar extinction curve. A search for their spectral signatures should allow one to set significant limits for the abundances of specific PAHs in the diffuse ISM. When ionized, small PAHs also absorb in the visible and NIR close to the position of well-known DIBs. It is found that the absorption spectra of compact PAH ions are always clearly dominated by one single band. As a result, the observed distribution of the DIBs between strong and weak features can be explained, in the context of the PAH proposal, in terms of the distribution of the band carriers between compact and non — compact PAH ions. Based on these promisingresults it is argued that PAH ions constitute good candidates to explain (some of) the DIBs.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Salama, Farid},
	editor = {Fausto, R.},
	year = {1996},
	pages = {169--191},
}

@incollection{fausto_conformational_1996,
	address = {Dordrecht},
	title = {Conformational isomerism and photodecomposition of carboxylic compounds studied by matrix isolation infrared spectroscopy},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_4},
	doi = {10.1007/978-94-009-0281-7_4},
	abstract = {Matrix isolation constitutes a very powerful sampling technique for spectroscopic studies. In particular this technique can be used successfully to study photochemical reactivity of isolated species submitted to irradiation by a suitable light source. Thus for example, conformational or tautomeric rearrangements and photodegradation reactions can be followed spectroscopically by conventional methods used in connection with it. In this article, the main advantages of using matrix isolation infrared spectroscopy to study conformational equilibria are shortly discussed and examples of application are presented. These include recent studies of photodegradation reactions of matrix-isolated carboxylic compounds.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Fausto, Rui},
	editor = {Fausto, R.},
	year = {1996},
	pages = {125--146},
}

@incollection{hollas_large_1996,
	address = {Dordrecht},
	title = {Large {Amplitude} {Vibrations} in {Electronic} {Spectra} in {Supersonic} {Jets}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_13},
	doi = {10.1007/978-94-009-0281-7_13},
	abstract = {Large amplitude, low wavenumber vibrations are particularly important in molecular structure determination. Such vibrations can usually be categorised as either of the inversion or torsional type and are rather difficult to investigate, particularly in large molecules, by the more usual techniques of infrared or Raman spectroscopy. Various techniques employing electronic spectroscopy in a supersonic jet allow access not only to low wavenumber fundamentals in the ground electronic state but also to overtone levels from which a potential energy function can be constructed. From this potential details of molecular conformation can be obtained. Similar information can be gained for low-lying excited electronic states and the ground state of the positive ion.},
	language = {en},
	urldate = {2024-09-01},
	booktitle = {Low {Temperature} {Molecular} {Spectroscopy}},
	publisher = {Springer Netherlands},
	author = {Hollas, J. M.},
	editor = {Fausto, R.},
	year = {1996},
	pages = {311--350},
}

@incollection{redington_heavy_1996,
	address = {Dordrecht},
	title = {Heavy {Atom} {Effects} in {Proton} {Tunneling} {Phenomena}},
	isbn = {978-94-009-0281-7},
	url = {https://doi.org/10.1007/978-94-009-0281-7_9},
	doi = {10.1007/978-94-009-0281-7_9},
	abstract = {Intramolecular H tunneling is often analyzed using 1-D theoretical models, or improved models providing a minimum energy pathway defined by model 2- or 3-D PEFs, or models coupling a 1-D tunneling coordinate to a vibrational bath representing all other modes. The analysis of a tunneling coordinate strongly coupled to one or two heavy atom vibrational modes is of much current interest. This problem, which includes heavy atom vibrational-assisted H tunneling, is experimentally accessible to the methods of low-temperature spectroscopy on molecular beam, matrix-isolated, and solid state samples. Heavy atom effects on intramolecular H tunneling, primarily as observed by optical spectroscopy, are considered in this discussion.},
