@article{basiuk_dft_2004,
	title = {{DFT} study of {HCN} and {N}{C}{C}{N} reactions with hydrogen species},
	volume = {99},
	copyright = {Copyright © 2004 Wiley Periodicals, Inc.},
	issn = {1097-461X},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/qua.20133},
	doi = {10.1002/qua.20133},
	abstract = {Energetic feasibility of the formation of aminoacetonitrile (or glycine nitrile) through a sequence of reactions of cyanogen (NCCN) with hydrogen species was evaluated, using density functional theory (DFT) calculations at the B3LYP/ 6-31++G(d,p) theoretical level. A critical step in the cyanogen hydrogenation is the addition of first H atom. As a result of a positive activation barrier of ∼3–6 kcal mol−1 (depending on the attachment site), this process is hardly feasible under cold gas-phase interstellar conditions, but might possibly be facilitated in the solid phase by proton tunneling effects. The addition of a third hydrogen atom requires much lower activation energy, especially if H adds on the NH group (0.2–0.8 kcal mol−1). The second and fourth steps (combination of C2HN2 and C2H3N2 radical species with hydrogen atoms) are highly exothermic; the need to get rid of excess energy makes them possible through grain-surface processes only. As a whole, most of the hydrogenation reactions under study can be expected to take place in the solid phase (icy and silicate grains), and not in the gas phase under cold interstellar conditions. © 2004 Wiley Periodicals, Inc. Int J Quantum Chem, 2004},
	language = {en},
	number = {2},
	urldate = {2019-04-09},
	journal = {International Journal of Quantum Chemistry},
	author = {Basiuk, Vladimir A. and Kobayashi, Kensei},
	year = {2004},
	keywords = {B3LYP, DFT, cyanogen, glycine nitrile, interstellar, radical reactions},
	pages = {91--101},
}

