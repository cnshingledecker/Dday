@article{van_dishoeck_comprehensive_1986,
	title = {Comprehensive models of diffuse interstellar clouds - {Physical} conditions and molecular abundances},
	volume = {62},
	issn = {0067-0049},
	url = {http://adsabs.harvard.edu/abs/1986ApJS...62..109V},
