}

@article{cernicharo_tentative_1986,
	title = {Tentative detection of the {C5H} radical},
	volume = {164},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1986A%26A...164L...1C},
	abstract = {Six line doublets, discovered with the IRAM 30-m telescope in the millimeter-wave spectrum of IRC+10216, have been identified as the J = 31/2-29/2 and J = 35/2-33/2 to 43/2-41/2 rotational transitions of a new radical with a 2Pi ground state. The rotation and distortion constants of this radical are Bo = 2387.01 + or - 0.02 MHz and Do = 50 + or - 20 Hz (2sigma). The new radical is tentatively identified with C5H, for which Bo of about 2375 MHz is estimated from standard bond length considerations. An alternate, although less likely, candidate would be C4N.},
	urldate = {2017-10-06},
	journal = {Astronomy and Astrophysics},
	author = {Cernicharo, J. and Kahane, C. and Gomez-Gonzalez, J. and Guelin, M.},
	month = aug,
	year = {1986},
	keywords = {Ground State, Hydrocarbons, Infrared Stars, Line Spectra, Millimeter Waves, Molecular Chains, Molecular Rotation, Molecular Structure, Radicals, Spectrum Analysis, Stellar Composition, Stellar Envelopes, Stellar Spectra},
	pages = {L1--L4},
}

@article{guelin_new_1986,
	title = {A new free radical in {IRC} + 10216},
	volume = {157},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1986A%26A...157L..17G},
	abstract = {The authors report the discovery of a new "non terrestrial" molecule in the envelope of the carbon star IRC +10216. This molecule is linear or slightly asymmetric and must have an odd number of electrons; its electronic ground state is very probably split by spin-rotation
interaction, i.e. must be 2Σ if the molecule is linear. The rotation and spin-doubling constants are found to be 5966.8 MHz and ±15.1 MHz, respectively. The most likely candidates for such a
radical are HSiCC (or its isomer HCCSi) and HSCC.},
	urldate = {2017-10-06},
	journal = {Astronomy and Astrophysics},
	author = {Guelin, M. and Gomez-Gonzalez, J. and Cernicharo, J. and Kahane, C.},
	month = mar,
	year = {1986},
	keywords = {Carbon Stars, Electron Spin, Extraterrestrial Matter, Free Radicals, Ground State, Infrared Stars, Interstellar Matter, Molecular Clouds, Stellar Composition, Stellar Envelopes},
	pages = {L17--L20},
}

@article{ziurys_hcnh+_1986,
	title = {{HCNH}(+) - {A} new interstellar molecular ion},
	volume = {302},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1986ApJ...302L..31Z},
	doi = {10.1086/184631},
	abstract = {The first interstellar detection of HCNH(+) is reported. The J = 1-0, 2-1, and 3-2 rotational transitions of this molecule at 74, 148, and 222 GHz have been observed toward Sgr B2. Using a large velocity gradient model calculation, the column density of HCNH(+) is found to be about 4 x 10 to the 14th/sq cm, about one order of magnitude less than that estimated for HCO(+) and HCN in this source. Such a column density implies a fractional abundance of at least one to several orders of magnitude larger than predicted by numerous ion-molecule models. Coupled with a relatively low abundance of HCN and a small HNC/HCN ratio, this suggests that HCNH(+) is not channeled into HCN or HNC as rapidly as thought.},
	urldate = {2017-10-06},
	journal = {The Astrophysical Journal Letters},
	author = {Ziurys, L. M. and Turner, B. E.},
	month = mar,
	year = {1986},
	keywords = {Abundance, Computational Astrophysics, Hydrocyanic Acid, Interstellar Chemistry, Interstellar Matter, Molecular Ions, Molecular Rotation},
	pages = {L31--L36},
}

@article{guelin_detection_1987,
	title = {Detection of a heavy radical in {IRC} + 10216 - {The} hexatriynyl radical {C6H}?},
	volume = {175},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1987A%26A...175L...5G},
	abstract = {Six line doublets and two related lines, discovered with the IRAM 30 m telescope in the millimetre-wave spectrum of IRC +10216, are identified as the J = 26.5→25.5 and J = 29.5→28.5 through 35.5→34.5
rotational transitions of a new "non terrestrial" molecule in a
2Π state. The new radical has an effective rotation
constant of 1386.245 MHz and is thought to contain 5 - 6 heavy atoms. It is observed at centimetre wavelengths in TMC1, a cold interstellar cloud, known to be rich in carbon chain molecules. The authors identify it with C6H.},
	urldate = {2017-10-06},
	journal = {Astronomy and Astrophysics},
