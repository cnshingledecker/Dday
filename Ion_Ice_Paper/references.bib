	pages = {L5--L8},
}

@article{suzuki_detection_1986,
	title = {Detection of the interstellar {C6H} radical},
	volume = {38},
	issn = {0004-6264},
	url = {http://adsabs.harvard.edu/abs/1986PASJ...38..911S},
	abstract = {The authors have detected three doublets at 23.6, 40.2, and 43.0 GHz from TMC-1. They have identified these lines as the J = 17/2 - 15/2, J = 29/2 - 27/2, and J = 31/2 - 29/2 transitions of a new interstellar radical in the 2Π3/2 state. The molecular
constants of the radical have been determined. On the basis of the rotational constant obtained and the doublet hyperfine structure for the Λ-type components of the J = 17/2 - 15/2 transition, the authors have concluded that the radical responsible for the spectral lines detected is C6H. The relative abundances of CnH (n = 2 - 6) are also discussed.},
