@article{rodriguez-fernandez_iso_2004,
	title = {{ISO} observations of the {Galactic} center interstellar medium - {Neutral} gas and dust},
	volume = {427},
	copyright = {© ESO, 2004},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2004/43/aa1370/aa1370.html},
	doi = {10.1051/0004-6361:20041370},
	abstract = {The 500 central pc of the Galaxy (hereafter GC) exhibit a widespread gas component with a kinetic temperature of 100–200 K. The bulk of this gas is not associated to the well-known thermal radio continuum or far infrared sources like Sgr A or Sgr B. How this gas is heated has been a longstanding problem. With the aim of studying the thermal balance of the neutral gas and dust in the GC, we have observed 18 molecular clouds located at projected distances far from thermal continuum sources with the Infrared Space Observatory (ISO). In this paper we present observations of several fine structure lines ([Oi] 63 and 146 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m, [Cii] 158 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m, [Si ii] 35 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m, [S i] 25 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m and [Fe ii] 26 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m), which are the main coolants of the gas with kinetic temperatures of several hundred K. We also present the full continuum spectra of the dust between 40 and 190 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m. All the clouds exhibit a cold dust component with a temperature of {\textasciitilde}15 K. A warmer dust component is also required to fit the spectra. The temperature of this dust component changes between 27 and 42 K from source to source. We have compared the gas and the dust emission with the predictions from J-type and C-type shocks and photodissociation region (PDRs) models. We conclude that the dust and the fine structure lines observations are best explained by a PDR with a density of 10{\textless}sup{\textgreater}3{\textless}sup/{\textgreater} cm{\textless}sup{\textgreater}-3{\textless}sup/{\textgreater} and an incident far-ultraviolet field 10{\textless}sup{\textgreater}3{\textless}sup/{\textgreater} times higher than the local interstellar radiation field. The fine structure line emission arises in PDRs in the interface between a diffuse ionized gas component and the dense molecular clouds. The [Cii] 158 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m and [Si ii] 35 {\textless}i{\textgreater}μ{\textless}i/{\textgreater}m lines also have an important contribution from the ionized gas component. PDRs can naturally explain the discrepancy between the gas and the dust temperatures. However, these PDRs can only account for 10–30\% of the total H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} column density with a temperature of {\textasciitilde}150 K. We discuss other possible heating mechanisms for the rest the warm molecular gas, such as non-stationary PDRs, X-ray Dominated Regions (XDRs) or the dissipation of supersonic turbulence.},
	language = {en},
	number = {1},
	urldate = {2020-01-14},
	journal = {Astronomy \& Astrophysics},
	author = {Rodríguez-Fernández, N. J. and Martín-Pintado, J. and Fuente, A. and Wilson, T. L.},
	month = nov,
	year = {2004},
	pages = {217--229},
}

