	url = {https://ui.adsabs.harvard.edu/abs/2000A%26A...354L...6C/abstract},
	abstract = {Using a reasonably large chemical reaction network consisting of 421 species, we show that along with normal chemical evolution of molecular cloud during collapse and star formation, significant amount of adenine, a DNA base, may be produced after an evolution of 10{\textless}SUP{\textgreater}6-7{\textless}/SUP{\textgreater} years. This findings may shed light on whether life on earth had to begin from scratch or these molecules could have contaminated the earth from the beginning.},
