@article{adams_study_1984,
	title = {A study of the reactions of {NH3}+· and {ND3}+· with {H2} and {D2} at several temperatures},
	volume = {61},
	issn = {0168-1176},
	url = {http://www.sciencedirect.com/science/article/pii/0168117684851241},
	doi = {10.1016/0168-1176(84)85124-1},
	abstract = {In an attempt to understand the unusual variation with temperature of the rate coefficient, k(1), for the atom abstraction reaction NH3+· + H2 → NH4+ +H· [reaction (1)], we have studied the analogous reactions of NH3+· with D2 [reaction (3)] and of ND3+· with D2 and H2 [reactions (2) and (4), respectively] in a selected-ion flow tube (SIFT) experiment at temperatures within the range 85–510 K. Above ∼ 300 K, the rate coefficients for all four reactions increase with temperature and asymtotically approach each other. This behaviour is consistent with the presence of activation energy barriers on the potential surfaces. Also, at these temperatures isotope effects are negligible. At low temperatures, the present data suggest that k(1) and k(4) will increase with decreasing temperature and this has been confirmed by Dunn and Barlow in a liquid-helium-cooled ion-trap experiment. This low temperature behaviour is characteristic of rate coefficients, k, which are controlled by the lifetimes of the intermediate complexes. Marked differences in k were also observed at low temperatures in these SIFT experiments and atom abstraction and isotope exchange were evident in reactions (3) and (4). k(2) and k(3) (D2 reactant) are significantly smaller than k(1) and k(4) (H2 reactant) and we have tentatively suggested that this is partly due to the slower migration of D atoms over or through the potential energy barriers.},
	number = {1},
	urldate = {2018-05-10},
	journal = {International Journal of Mass Spectrometry and Ion Processes},
	author = {Adams, N. G. and Smith, D.},
	month = sep,
	year = {1984},
	pages = {133--139},
}

