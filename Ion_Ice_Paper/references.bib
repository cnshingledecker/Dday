	volume = {56},
	issn = {0004-6361},
	url = {http://adsabs.harvard.edu/abs/1977A%26A....56....1N},
	abstract = {The molecular absorption feature whose maximum intensity occurs at approximately 9910 A in the near-IR spectra of M dwarfs and S stars with strong S characteristics is tentatively identified with iron hydride. Observations of the 9910-A band in M dwarfs and Mira-type S stars are reviewed, the laboratory IR spectrum of FeH is discussed, and
comparisons are made with the spectra of Wolf 359, Barnard's star, and R Cygni. It is noted that stellar spectra of higher resolution (at least 15 A/mm) are needed for definitive confirmation of the FeH origin of the present absorption feature. Reasons for the absence of this feature in spectra of M giants and mild S stars are considered.},
	urldate = {2018-07-01},
