@article{rawlings_direct_1992,
	title = {Direct diagnosis of infall in collapsing protostars. {I} - {The} theoretical identification of molecular species with broad velocity distributions},
	volume = {255},
	issn = {0035-8711},
	url = {http://adsabs.harvard.edu/abs/1992MNRAS.255..471R},
	doi = {10.1093/mnras/255.3.471},
	abstract = {Chemical models, including depletion onto grains, are developed for the 
collapsing envelopes of protostars in order to identify molecular
species having broad velocity distributions so that observations of
their line profiles can be employed to diagnose the dynamics of the
protostar formation and to yield information on the collapse age and
depletion rate. Results from the present model indicate that the
collapse initiates very soon after the formation of an isothermal
pressure-balanced sphere. It is demonstrated that as depletion reduces
the fractional abundance of NH3 in the accelerating gas of an infalling
envelope and prevents the formation of broad wings on NH3 emission
lines, the fractional abundances of some other species initially
increase as the heavy elements become depleted, causing those species to
have emission lines broader than those of NH3.},
	urldate = {2019-12-10},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Rawlings, J. M. C. and Hartquist, T. W. and Menten, K. M. and Williams, D. A.},
	month = apr,
	year = {1992},
	keywords = {Ammonia, Gravitational Collapse, Interstellar Chemistry, Line Shape, Line Spectra, Molecular Ions, Protostars, Stellar Envelopes, Stellar Models, Velocity Distribution},
	pages = {471--485},
}

@article{kama_abundant_2019,
	title = {Abundant {Refractory} {Sulfur} in {Protoplanetary} {Disks}},
	volume = {885},
	issn = {0004-637X},
	url = {https://doi.org/10.3847%2F1538-4357%2Fab45f8},
	doi = {10.3847/1538-4357/ab45f8},
	abstract = {Sulfur is one of the most abundant elements in the universe, with important roles in astro-, geo-, and biochemistry. Its main reservoirs in planet-forming disks have previously eluded detection: gaseous molecules only account for {\textless}1\% of total elemental sulfur, with the rest likely in either ices or refractory minerals. We use a new method to measure the refractory component. Mechanisms such as giant planets can filter out dust from gas accreting onto disk-hosting stars. For stars above 1.4 solar masses, this leaves a chemical signature on the stellar photosphere that can be used to determine the fraction of each element that is locked in dust. Here, we present an application of this method to sulfur, zinc, and sodium. We analyze the accretion-contaminated photospheres of a sample of young stars and find (89 ± 8)\% of elemental sulfur is in refractory form in their disks. The main carrier is much more refractory than water ice, consistent with sulfide minerals such as FeS.},
	language = {en},
	number = {2},
	urldate = {2019-12-10},
	journal = {The Astrophysical Journal},
	author = {Kama, Mihkel and Shorttle, Oliver and Jermyn, Adam S. and Folsom, Colin P. and Furuya, Kenji and Bergin, Edwin A. and Walsh, Catherine and Keller, Lindsay},
	month = nov,
	year = {2019},
	pages = {114},
}

@article{kuwahata_signatures_2015,
	title = {Signatures of {Quantum}-{Tunneling} {Diffusion} of {Hydrogen} {Atoms} on {Water} {Ice} at 10 {K}},
	volume = {115},
	url = {https://link.aps.org/doi/10.1103/PhysRevLett.115.133201},
	doi = {10.1103/PhysRevLett.115.133201},
	abstract = {Reported here is the first observation of the tunneling surface diffusion of a hydrogen (H) atom on water ice. Photostimulated desorption and resonance-enhanced multiphoton ionization methods were used to determine the diffusion rates at 10 K on amorphous solid water and polycrystalline ice. H-atom diffusion on polycrystalline ice was 2 orders of magnitude faster than that of deuterium atoms, indicating the occurrence of tunneling diffusion. Whether diffusion is by tunneling or thermal hopping also depends on the diffusion length of the atoms and the morphology of the surface. Our findings contribute to a better understanding of elementary physicochemical processes of hydrogen on cosmic ice dust.},
	number = {13},
	urldate = {2019-12-10},
	journal = {Physical Review Letters},
	author = {Kuwahata, K. and Hama, T. and Kouchi, A. and Watanabe, N.},
	month = sep,
	year = {2015},
	pages = {133201},
}

