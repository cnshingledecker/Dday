	keywords = {Abundance, Cyano Compounds, Free Radicals, Hyperfine Structure, Interstellar Matter, Methyl Compounds, Milky Way Galaxy, Molecular Clouds},
	pages = {L107--L111},
}

@article{hinkle_detection_1988,
