}

@article{turner_detection_1992-1,
	title = {Detection of {SiN} in {IRC} + 10216},
	volume = {388},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1992ApJ...388L..35T},
	doi = {10.1086/186324},
	abstract = {The first extraterrestrial silicon-nitrogen molecule, SiN, has been detected in the outer circumstellar envelope IRC + 10216, by means of five transitions in the 1 and 3 mm spectral regions. The column density is N(SiN) = 3.8 x 10 exp 13/sq cm, and, together with recent
redetermination of the SiC2 abundance, means that SiN/SiC2 is about equal to 0.05 NH3/C2H2, assuming the latter ratio is similar in the outer envelope to the value found by IR observations in the inner core. This result is probably consistent with predictions of the 1989
ion-molecule model of Herbst et al., with Si(+) the progenitor of both SiN and SiC2. The source of Si(+) is proposed to be SiH4, the carrier of gaseous Si to the outer envelope. SiH4 photodissociates first to silylene (SiH2), then to Si(+) and Si. The fraction of all silicon lost to the interstellar medium in gaseous form is between 1 x 10 exp -4 and 2 x 10 exp -3. Thus, the traditional idea that the interstellar
gas-to-dust ratio of about 100 represents the condensation of all refractory elements in mass-losing evolved stars needs no revision.},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {Turner, B. E.},
	month = mar,
	year = {1992},
	keywords = {Carbon Stars, Electron Transitions, Interstellar Chemistry, Interstellar Matter, Silicon Nitrides, Stellar Envelopes},
	pages = {L35--L38},
}

@article{kawaguchi_detection_1992-1,
	title = {Detection of isocyanoacetylene {HCCNC} in {TMC}-1},
	volume = {386},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1992ApJ...386L..51K},
	doi = {10.1086/186290},
	abstract = {The detection is reported of the linear HCCNC molecule, an isomer of cyanoacetylene HCCCN, in TMC-1 with the Nobeyama 45-m telescope using recent laboratory data reported by Krueger (1991). Molecular line data in the frequency range of 9-115 GHz are obtained in order to study the whole dark-cloud molecular abundance and chemistry. The frontends used in the 40- and 89-GHz regions were an SIS receiver and a cooled Schottky diode receiver, respectively, with single-sideband filters. A single line was detected at 39742.6 MGz in March 1986 with an antenna
temperature of 0.33 K, which could not be assigned to any transitions of known molecules. In the line survey data, an unidentified line at 49677.9 MHz, which had been observed in February 1985, was also
detected. The column density of HCCNC in TMC-1 is determined to be 2.9(0.2) x 10 exp 12/sq cm, which is 20-60 times smaller than that of HCCCN.},
	urldate = {2017-10-09},
	journal = {The Astrophysical Journal Letters},
	author = {Kawaguchi, Kentarou and Ohishi, Masatoshi and Ishikawa, Shin-Ichi and Kaifu, Norio},
	month = feb,
	year = {1992},
	keywords = {Abundance, Cyanoacetylene, Interstellar Chemistry, Isomers, Line Spectra, Molecular Clouds, Molecular Spectra, Taurus Constellation, Telescopes},
	pages = {L51--L53},
}

@article{ohishi_detection_1991,
	title = {Detection of a new carbon-chain molecule, {CCO}},
	volume = {380},
	issn = {0004-637X},
	url = {http://adsabs.harvard.edu/abs/1991ApJ...380L..39O},
	doi = {10.1086/186168},
	abstract = {A new carbon-chain molecule, CCO 3Sigma(-), has been detected in the cold dark molecular cloud TMC-1. The excitation temperature and the column density of CCO are, respectively, about 6 K and about 6 x 10 to the 11th/sq cm. This column density corresponds to a fractional
abundance relative to H2 of about 6 x 10 to the -11th. This value is two orders of magnitude less than the abundance of the related carbon-chain molecule CCS, and about half that of C3O. The formation mechanism for CCO is discussed.},
	urldate = {2017-10-09},
