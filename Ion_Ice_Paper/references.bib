@article{danilovich_sulphur-bearing_2017,
	title = {Sulphur-bearing molecules in {AGB} stars - {I}. {The} occurrence of hydrogen sulphide},
	volume = {606},
	copyright = {© ESO, 2017},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2017/10/aa31203-17/aa31203-17.html},
	doi = {10.1051/0004-6361/201731203},
	abstract = {{\textless}i{\textgreater}Context. {\textless}i/{\textgreater}Sulphur is a relatively abundant element in the local Galaxy that is known to form a variety of molecules in the circumstellar envelopes of AGB stars. The abundances of these molecules vary based on the chemical types and mass-loss rates of AGB stars.{\textless}i{\textgreater}Aims. {\textless}i/{\textgreater}Through a survey of (sub-)millimetre emission lines of various sulphur-bearing molecules, we aim to determine which molecules are the primary carriers of sulphur in different types of AGB stars. In this paper, the first in a series, we investigate the occurrence of H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S in AGB circumstellar envelopes and determine its abundance, where possible.{\textless}i{\textgreater}Methods. {\textless}i/{\textgreater}We surveyed 20 AGB stars with a range of mass-loss rates and different chemical types using the Atacama Pathfinder Experiment (APEX) telescope to search for rotational transition lines of five key sulphur-bearing molecules: CS, SiS, SO, SO{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}, and H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S. Here we present our results for H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S, including detections, non-detections, and detailed radiative transfer modelling of the detected lines. We compared results based on various descriptions of the molecular excitation of H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S and different abundance distributions, including Gaussian abundances, where possible, and two different abundance distributions derived from chemical modelling results.{\textless}i{\textgreater}Results. {\textless}i/{\textgreater}We detected H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S towards five AGB stars, all of which have high mass-loss rates of {\textless}i{\textgreater}Ṁ{\textless}i/{\textgreater} ≥ 5 × 10{\textless}sup{\textgreater}-6{\textless}sup/{\textgreater} {\textless}i{\textgreater}M{\textless}i/{\textgreater}{\textless}sub{\textgreater}⊙{\textless}sub/{\textgreater} yr{\textless}sup{\textgreater}-1{\textless}sup/{\textgreater} and are oxygen rich. H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S was not detected towards the carbon or S-type stars that fall in a similar mass-loss range. For the stars in our sample with detections, we find peak o-H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S abundances relative to H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater} between 4 × 10{\textless}sup{\textgreater}-7{\textless}sup/{\textgreater} and 2.5 × 10{\textless}sup{\textgreater}-5{\textless}sup/{\textgreater}.{\textless}i{\textgreater}Conclusions. {\textless}i/{\textgreater}Overall, we conclude that H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S can play a significant role in oxygen-rich AGB stars with higher mass-loss rates, but is unlikely to play a key role in stars of other chemical types or in lower mass-loss rate oxygen-rich stars. For two sources, V1300 Aql and GX Mon, H{\textless}sub{\textgreater}2{\textless}sub/{\textgreater}S is most likely the dominant sulphur-bearing molecule in the circumstellar envelope.},
	language = {en},
	urldate = {2019-06-21},
	journal = {Astronomy \& Astrophysics},
	author = {Danilovich, T. and Sande, M. Van de and Beck, E. De and Decin, L. and Olofsson, H. and Ramstedt, S. and Millar, T. J.},
	month = oct,
	year = {2017},
	pages = {A124},
}

